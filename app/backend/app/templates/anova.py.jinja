        print(f"**p-value (permutation) = {fmt_p(jt_p)}**")
        
        if jt_p < 0.05:
            print("**Significant monotonic trend detected**")
        else:
            print("No significant monotonic trend detected")
            
        output_metrics["trend_test"] = {
            "name": "Jonckheere-Terpstra",
            "statistic": float(jt_stat),
            "z_statistic": float(z_stat),
            "p_value_asymptotic": float(p_norm),
            "p_value": float(jt_p),
            "significant": bool(jt_p < 0.05)
        }
    except Exception as ex:
