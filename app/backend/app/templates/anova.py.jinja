ax1 = axes[0]
positions = range(len(groups))
for i, g in enumerate(groups):
    vals = data_by_group[g]
    ax1.boxplot([vals], positions=[i], widths=0.5, patch_artist=True,
                boxprops=dict(facecolor=plt.cm.Set2(i/len(groups)), alpha=0.7))
    jitter = np.random.normal(i, 0.04, size=len(vals))
    ax1.scatter(jitter, vals, alpha=0.4, s=10, color='black')
ax1.set_xticks(positions)
ax1.set_xticklabels(plot_labels)
ax1.set_ylabel(value_col)
ax1.set_title(f'{value_col} by {group_col}')
ax1.grid(True, alpha=0.3, axis='y')

# Mean ± SD
ax2 = axes[1]
means = [np.mean(data_by_group[g]) for g in groups]
sds = [np.std(data_by_group[g], ddof=1) for g in groups]
ax2.bar(positions, means, yerr=sds, color=plt.cm.Set2(np.linspace(0, 1, len(groups))), capsize=8, alpha=0.8)
ax2.set_xticks(positions)
ax2.set_xticklabels(plot_labels)
ax2.set_ylabel(value_col)
ax2.set_title(f'Mean ± SD of {value_col} by {group_col}')
ax2.grid(True, alpha=0.3, axis='y')

plt.tight_layout()
plot_name = f"anova_{timestamp}"
save_plot(plot_name, fig)
output_metrics["plots"] = [f"{plot_name}.png"]
print(f"\n![ANOVA Plot](/plots/{plot_name}.png)\n")

# ========== SUMMARY ==========
print("---")
print("**Analysis complete**")

test_name = output_metrics.get("test_name", "?")
p_val = output_metrics.get("p_value", 1.0)
if p_val < 0.05:
    print(f"\n**Conclusion:** {test_name} shows significant differences between groups (p = {fmt_p(p_val)}).")
else:
    print(f"\n**Conclusion:** {test_name} shows no significant differences between groups (p = {fmt_p(p_val)}).")

# ========== JSON METRICS ==========
def make_serializable(obj):
    if isinstance(obj, dict):
        return {str(k): make_serializable(v) for k, v in obj.items()}
    elif isinstance(obj, (list, tuple)):
        return [make_serializable(v) for v in obj]
    elif isinstance(obj, (np.integer, np.int64)):
        return int(obj)
    elif isinstance(obj, (np.floating, np.float64)):
        if np.isnan(obj) or np.isinf(obj): return None
        return float(obj)
    elif isinstance(obj, float):
        return None if (np.isnan(obj) or np.isinf(obj)) else obj
    elif isinstance(obj, np.bool_):
        return bool(obj)
    elif obj is None:
        return None
    return obj

output_metrics = make_serializable(output_metrics)
print("\n<!-- JSON_METRICS_START -->")
print(json.dumps(output_metrics, ensure_ascii=False))
print("<!-- JSON_METRICS_END -->")
