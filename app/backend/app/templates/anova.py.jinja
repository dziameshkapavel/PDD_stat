print()

# ========== NORMALITY ==========
print("### Normality Test (Shapiro-Wilk)\n")
all_normal = True
print("| Group | W | p-value | Normal? |")
print("|-------|---|---------|---------|")
for g in groups:
    vals = data_by_group[g]
    if len(vals) >= 3:
        w, p = shapiro(vals)
        is_normal = p >= 0.05
        if not is_normal:
            all_normal = False
        print(f"| {g} | {w:.4f} | {fmt_p(p)} | {'Yes' if is_normal else 'No'} |")
print()

# ========== HOMOGENEITY ==========
print("### Homogeneity of Variances\n")
if n_groups >= 2:
    arrays = [data_by_group[g] for g in groups]
    lev_p = None
    try:
        lev_stat, lev_p = levene(*arrays)
        print(f"Levene's test: W = {lev_stat:.4f}, p = {fmt_p(lev_p)}")
        equal_var = lev_p >= 0.05
    except:
        equal_var = False
        print("Levene's test: could not compute")
print()

