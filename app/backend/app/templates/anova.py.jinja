# Format group label using user-defined labels or clean numbers
def format_group_label(g):
    """Format group value: use label if available, clean numbers"""
    # Try to find user label
    if group_col in var_labels:
        val_labels = var_labels[group_col].get('value_labels', {})
        g_str = str(g)
        try:
            g_float = float(g)
            g_float_str = str(g_float)
            g_int_str = str(int(g_float)) if g_float == int(g_float) else None
        except (ValueError, TypeError):
            g_float_str = g_str
            g_int_str = None
        
        for key, label in val_labels.items():
            if key == g_str or key == g_float_str:
                return label
            if g_int_str and key == g_int_str:
                return label
    
    # No user label — clean the number
    try:
        f = float(g)
        if f == int(f):
            return str(int(f))
    except (ValueError, TypeError):
        pass
    return str(g)

def adjust_p_values(p_values):
    n = len(p_values)
    if n == 0:
        return [], [], []
    p_bonf = [min(1.0, p * n) for p in p_values]
    
    indexed_p = sorted(enumerate(p_values), key=lambda x: x[1])
    p_holm_sorted = []
    max_p = 0.0
    for rank, (orig_idx, p) in enumerate(indexed_p):
        p_adj = p * (n - rank)
        max_p = max(max_p, p_adj)
        p_holm_sorted.append((orig_idx, min(1.0, max_p)))
    p_holm = [0.0] * n
    for orig_idx, val in p_holm_sorted:
        p_holm[orig_idx] = val
        
    indexed_p_desc = sorted(enumerate(p_values), key=lambda x: x[1], reverse=True)
    p_bh_sorted = []
    min_p = 1.0
    for rank, (orig_idx, p) in enumerate(indexed_p_desc):
        curr_rank = n - rank
        p_adj = p * n / curr_rank
        min_p = min(min_p, p_adj)
        p_bh_sorted.append((orig_idx, min(1.0, min_p)))
    p_bh = [0.0] * n
    for orig_idx, val in p_bh_sorted:
        p_bh[orig_idx] = val
        
    return p_bonf, p_holm, p_bh

def welch_anova(groups_data):
    k = len(groups_data)
    means = np.array([np.mean(g) for g in groups_data])
    vars_ = np.array([np.var(g, ddof=1) for g in groups_data])
    ns = np.array([len(g) for g in groups_data])
    
    ws = ns / vars_
    w_sum = np.sum(ws)
    mean_w = np.sum(ws * means) / w_sum
    
    num = np.sum(ws * (means - mean_w)**2) / (k - 1)
    lambdas = ws / w_sum
    denom_term = np.sum((1.0 - lambdas)**2 / (ns - 1))
    denom = 1.0 + 2.0 * (k - 2) / (k**2 - 1) * denom_term
    
    f_stat = num / denom
    df1 = k - 1
    df2 = (k**2 - 1) / (3.0 * denom_term)
    
    p_val = 1.0 - stats.f.cdf(f_stat, df1, df2)
    return f_stat, df1, df2, p_val

def games_howell_test(groups, data_by_group):
    from scipy.stats import studentized_range
    k = len(groups)
    means = {g: np.mean(data_by_group[g]) for g in groups}
    vars_ = {g: np.var(data_by_group[g], ddof=1) for g in groups}
    ns = {g: len(data_by_group[g]) for g in groups}
    
    results = []
    from itertools import combinations
    for g1, g2 in combinations(groups, 2):
        m1, m2 = means[g1], means[g2]
        v1, v2 = vars_[g1], vars_[g2]
        n1, n2 = ns[g1], ns[g2]
        
        md = m1 - m2
        se = np.sqrt(0.5 * (v1/n1 + v2/n2))
        q = abs(md) / se if se > 0 else 0
        
        df_num = (v1/n1 + v2/n2)**2
        df_den = (v1/n1)**2 / (n1 - 1) + (v2/n2)**2 / (n2 - 1)
        df = df_num / df_den if df_den > 0 else 1
        
        p_val = 1.0 - studentized_range.cdf(q, k, df)
        
        results.append({
            "group1": g1, "group2": g2,
            "mean_diff": md, "q_stat": q,
            "df": df, "p_value": p_val
        })
    return results

def jonckheere_terpstra_test(groups_data, n_permutations=2000):
    k = len(groups_data)
    groups_data = [np.asarray(g) for g in groups_data]
    n = [len(g) for g in groups_data]
    N = sum(n)
    
    def compute_j(data_list):
        J_val = 0.0
        for i in range(k - 1):
            g_i = data_list[i]
            for j in range(i + 1, k):
                g_j = data_list[j]
                diff = g_j[:, None] - g_i[None, :]
                J_val += np.sum(diff > 0) + 0.5 * np.sum(diff == 0)
        return J_val

    J_obs = compute_j(groups_data)
    
    pooled = np.concatenate(groups_data)
    split_indices = np.cumsum(n)[:-1]
    
    # Adaptive permutation count
    if N > 500:
        n_permutations = 200
    elif N > 200:
        n_permutations = 500
    
    perm_Js = []
    for _ in range(n_permutations):
        perm_pooled = np.random.permutation(pooled)
        perm_groups = np.split(perm_pooled, split_indices)
        perm_Js.append(compute_j(perm_groups))
        
    perm_Js = np.array(perm_Js)
    E_J = (N**2 - sum(ni**2 for ni in n)) / 4.0
    obs_dev = abs(J_obs - E_J)
    perm_devs = abs(perm_Js - E_J)
    p_val = (np.sum(perm_devs >= obs_dev) + 1) / (n_permutations + 1) if n_permutations > 0 else 1.0
    
    var_J = (N**2 * (2*N + 3) - sum(ni**2 * (2*ni + 3) for ni in n)) / 72.0
    se = np.sqrt(var_J)
    z_stat = (J_obs - E_J) / se if se > 0 else 0
    p_norm = 2.0 * (1.0 - stats.norm.cdf(abs(z_stat)))
    
    # Use normal approximation if permutation test not run or sample size is very large
    final_p = p_val if n_permutations > 0 else p_norm
    return J_obs, final_p, z_stat, p_norm


