# ========== MAIN TEST ==========
output_metrics = {
    "model_type": "anova",
    "value_col": value_col,
    "group_col": group_col,
    "n_total": n_total,
    "n_groups": n_groups,
    "groups": [format_group_label(g) for g in groups],
    "group_labels": {str(g): format_group_label(g) for g in groups},
    "all_normal": all_normal,
    "equal_var": equal_var,
    "levene_p": lev_p,
    "descriptive": descriptive_stats,
    "posthoc": []
}

if all_normal and equal_var and n_groups >= 2:
    # ONE-WAY ANOVA
    print("### One-way ANOVA\n")
    f_stat, anova_p = f_oneway(*arrays)
    print(f"F({n_groups-1}, {n_total-n_groups}) = {f_stat:.4f}")
    print(f"**p = {fmt_p(anova_p)}**")
    
    # Effect size: eta-squared
    grand_mean = np.mean(df_clean[value_col].values)
    ss_between = sum(len(data_by_group[g]) * (np.mean(data_by_group[g]) - grand_mean)**2 for g in groups)
    ss_total = sum((df_clean[value_col].values - grand_mean)**2)
    eta_sq = ss_between / ss_total if ss_total > 0 else 0
    denom_omega = n_total - n_groups
    if denom_omega > 0:
        mse = (ss_total - ss_between) / denom_omega
        omega_sq = (ss_between - (n_groups - 1) * mse) / (ss_total + mse) if ss_total > 0 else 0
    else:
        omega_sq = 0.0
    
    print(f"η² = {eta_sq:.4f}")
    print(f"ω² = {omega_sq:.4f}\n")
    
    output_metrics["test_name"] = "ANOVA"
    output_metrics["F_stat"] = float(f_stat)
    output_metrics["p_value"] = float(anova_p)
    output_metrics["eta_sq"] = float(eta_sq)
    output_metrics["omega_sq"] = float(omega_sq)
    output_metrics["significant"] = bool(anova_p < 0.05)
    
    # Post-hoc Tukey HSD
    if anova_p < 0.05 and n_groups >= 3:
        print("### Post-hoc: Tukey HSD\n")
        try:
            tukey = pairwise_tukeyhsd(df_clean[value_col].values, df_clean[group_col].values, alpha=0.05)
            print(tukey)
            # Extract as table
            print("\n| Comparison | Mean Diff | p-value | Significant |")
            print("|------------|-----------|---------|-------------|")
            for row in tukey.summary().data[1:]:
                comp = f"{row[0]} vs {row[1]}"
                diff = float(row[2])
                p_val = float(row[3])
                sig = "Yes" if row[4] else "No"
                print(f"| {comp} | {diff:.2f} | {fmt_p(p_val)} | {sig} |")
                output_metrics["posthoc"].append({
                    "group1": str(row[0]),
                    "group2": str(row[1]),
                    "mean_diff": diff,
                    "p_value": p_val,
                    "significant": bool(row[4])
                })
        except:
            print("*Post-hoc test could not be computed*\n")

elif all_normal and not equal_var and n_groups >= 2:
    # WELCH'S ANOVA
    print("### Welch's ANOVA\n")
    print("*Reason: Normality holds, but equal variance does not (Levene's p < 0.05)*\n")
    f_stat, df1, df2, anova_p = welch_anova(arrays)
    print(f"F({df1:.1f}, {df2:.2f}) = {f_stat:.4f}")
    print(f"**p = {fmt_p(anova_p)}**")
    
    # Effect size: eta-squared
    grand_mean = np.mean(df_clean[value_col].values)
    ss_between = sum(len(data_by_group[g]) * (np.mean(data_by_group[g]) - grand_mean)**2 for g in groups)
    ss_total = sum((df_clean[value_col].values - grand_mean)**2)
    eta_sq = ss_between / ss_total if ss_total > 0 else 0
    print(f"η² = {eta_sq:.4f}\n")
    
    output_metrics["test_name"] = "Welch ANOVA"
    output_metrics["F_stat"] = float(f_stat)
    output_metrics["df1"] = float(df1)
    output_metrics["df2"] = float(df2)
    output_metrics["p_value"] = float(anova_p)
    output_metrics["eta_sq"] = float(eta_sq)
    output_metrics["significant"] = bool(anova_p < 0.05)
    
    # Post-hoc Games-Howell
    if anova_p < 0.05 and n_groups >= 3:
        print("### Post-hoc: Games-Howell\n")
        try:
            gh_results = games_howell_test(groups, data_by_group)
            print("| Comparison | Mean Diff | q-statistic | df | p-value | Significant |")
            print("|------------|-----------|-------------|----|---------|-------------|")
            for r in gh_results:
                comp = f"{r['group1']} vs {r['group2']}"
                diff = r['mean_diff']
                q_val = r['q_stat']
                df_val = r['df']
                p_val = r['p_value']
                sig = "Yes" if p_val < 0.05 else "No"
                print(f"| {comp} | {diff:.2f} | {q_val:.4f} | {df_val:.1f} | {fmt_p(p_val)} | {sig} |")
                output_metrics["posthoc"].append({
                    "group1": str(r['group1']),
                    "group2": str(r['group2']),
                    "mean_diff": float(diff),
                    "q_statistic": float(q_val),
                    "df": float(df_val),
                    "p_value": float(p_val),
                    "significant": bool(p_val < 0.05)
                })
        except Exception as ex:
            print(f"*Post-hoc Games-Howell could not be computed: {ex}*\n")

else:
    # KRUSKAL-WALLIS
    print("### Kruskal-Wallis H Test\n")
    print(f"*Reason: {'Non-normal distribution' if not all_normal else 'Unequal variances'}*\n")
    h_stat, kw_p = kruskal(*arrays)
    print(f"H = {h_stat:.4f}")
    print(f"**p = {fmt_p(kw_p)}**")
    
    # Effect size: epsilon-squared
    epsilon_sq = h_stat / (n_total - 1) if n_total > 1 else 0
    print(f"ε² = {epsilon_sq:.4f}\n")
    
    output_metrics["test_name"] = "Kruskal-Wallis"
    output_metrics["H_stat"] = float(h_stat)
    output_metrics["p_value"] = float(kw_p)
    output_metrics["epsilon_sq"] = float(epsilon_sq)
    output_metrics["significant"] = bool(kw_p < 0.05)
    
    # Post-hoc Mann-Whitney with Bonferroni, Holm, BH/FDR correction
    if kw_p < 0.05 and n_groups >= 3:
        print("### Post-hoc: Pairwise Comparisons (Mann-Whitney)\n")
        print("*Multiple comparison corrections computed*\n")
        
        from itertools import combinations
        raw_ps = []
        pairs = []
        for g1, g2 in combinations(groups, 2):
            try:
                u_stat, u_p = stats.mannwhitneyu(data_by_group[g1], data_by_group[g2], alternative='two-sided')
                raw_ps.append(u_p)
                pairs.append((g1, g2))
            except:
                pass
                
        if raw_ps:
            p_bonf, p_holm, p_bh = adjust_p_values(raw_ps)
            print("| Comparison | p-value | p (Bonf) | p (Holm) | p (FDR/BH) | Significant? |")
            print("|------------|---------|----------|----------|------------|--------------|")
            for idx, (g1, g2) in enumerate(pairs):
                p_raw = raw_ps[idx]
                pb = p_bonf[idx]
                ph = p_holm[idx]
                pf = p_bh[idx]
                sig_str = "Yes **" if ph < 0.05 else "No"
                print(f"| {g1} vs {g2} | {fmt_p(p_raw)} | {fmt_p(pb)} | {fmt_p(ph)} | {fmt_p(pf)} | {sig_str} |")
                output_metrics["posthoc"].append({
                    "group1": str(g1),
                    "group2": str(g2),
                    "p_value": float(p_raw),
                    "p_bonferroni": float(pb),
                    "p_holm": float(ph),
                    "p_bh": float(pf),
                    "significant": bool(ph < 0.05)
                })

