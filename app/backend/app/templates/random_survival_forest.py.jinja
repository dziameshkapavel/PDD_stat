print(f"**Test set:** {len(X_test)} (events: {event_test.sum()})\n")

# Обучение Random Survival Forest
try:
    from sksurv.ensemble import RandomSurvivalForest
    from sksurv.metrics import concordance_index_censored
    from sksurv.util import Surv
    
    # Структурированные массивы для survival
    y_train_surv = Surv.from_arrays(event=event_train, time=time_train)
    y_test_surv = Surv.from_arrays(event=event_test, time=time_test)
    
    print("Training Random Survival Forest...\n")
    
    rsf = RandomSurvivalForest(
        n_estimators=200,
        min_samples_split=10,
        min_samples_leaf=5,
        max_features='sqrt',
        random_state=42,
        n_jobs=-1,
        oob_score=True
    )
    
    rsf.fit(X_train, y_train_surv)
    
    # C-index
    pred_train = rsf.predict(X_train)
    pred_test = rsf.predict(X_test)
    
    c_index_train = concordance_index_censored(event_train, time_train, pred_train)[0]
    c_index_test = concordance_index_censored(event_test, time_test, pred_test)[0]
    oob_score = rsf.oob_score_ if hasattr(rsf, 'oob_score_') else None
    
    output_metrics["c_index"] = float(c_index_test)
    output_metrics["oob_score"] = float(oob_score) if oob_score else None
    
