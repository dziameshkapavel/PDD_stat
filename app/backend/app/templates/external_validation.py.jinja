# external_validation.py.jinja
# External validation of a saved model on new data

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.metrics import (
    roc_auc_score, accuracy_score, precision_score, recall_score, 
    f1_score, brier_score_loss, confusion_matrix, roc_curve, auc
)
import json
import time
from pathlib import Path
import warnings
warnings.filterwarnings('ignore')

print("## External Model Validation\n")

target_col = "{{ target_col }}"
feature_map = {{ feature_map|default({})|tojson }}
category_mappings = {{ category_mappings|default({})|tojson }}
model_path = "{{ model_path|default('') }}"

# Validations
if not model_path:
    raise ValueError("Model path required")
if not Path(model_path).exists():
    raise ValueError("Model file not found")

# Load model
import joblib
bundle = joblib.load(model_path)
if isinstance(bundle, dict):
    model = bundle.get('model')
    features = bundle.get('features', [])
    training_metrics = bundle.get('training_metrics', {})
    feature_encodings = bundle.get('feature_encodings', {})
else:
    model = bundle
    features = []
    training_metrics = {}
    feature_encodings = {}

if model is None:
    raise ValueError("No model in file")

print(f"**Model type:** {type(model).__name__}")
print(f"**Training features:** {', '.join(features) if features else 'Unknown'}")

if training_metrics:
    print(f"\n### Training Metrics")
    for k, v in training_metrics.items():
        if v is not None:
            print(f"- {k}: {v:.4f}" if isinstance(v, float) else f"- {k}: {v}")

# Map features to columns
mapped_X = pd.DataFrame()
missing_features = []
for feat in features:
    if feat in feature_map:
        col = feature_map[feat]
    else:
        col = feat
    
    if col in df.columns:
        mapped_X[feat] = df[col]
    else:
        missing_features.append(feat)

if missing_features:
    raise ValueError(f"Missing columns: {missing_features}")

# Apply custom category mappings, then feature encodings
for col, custom_map in category_mappings.items():
    if col in mapped_X.columns and custom_map:
        mapped_X[col] = mapped_X[col].astype(str).map(custom_map)

for col, encoding in feature_encodings.items():
    if col in mapped_X.columns and mapped_X[col].dtype == 'object':
        rev_map = {str(v): int(k) for k, v in encoding.items()}
        mapped_X[col] = mapped_X[col].astype(str).map(rev_map)

# Make predictions
if hasattr(model, 'predict_proba'):
    y_pred_proba = model.predict_proba(mapped_X)[:, 1]
    y_pred = (y_pred_proba > 0.5).astype(int)
elif hasattr(model, 'predict'):
    y_pred = model.predict(mapped_X)
    y_pred_proba = None
else:
    raise ValueError("Model doesn't have predict method")

y_true = df[target_col]

event_value = {{ event_value|default(1)|int }}
if event_value == 0:
    y_true = 1 - y_true

# Calculate metrics
metrics = {}
metrics['n_samples'] = len(y_true)
metrics['accuracy'] = accuracy_score(y_true, y_pred)
metrics['precision'] = precision_score(y_true, y_pred, zero_division=0)
metrics['recall'] = recall_score(y_true, y_pred, zero_division=0)
metrics['f1'] = f1_score(y_true, y_pred, zero_division=0)

if y_pred_proba is not None:
    metrics['auc'] = roc_auc_score(y_true, y_pred_proba)
    metrics['brier'] = brier_score_loss(y_true, y_pred_proba)

# Confusion matrix
cm = confusion_matrix(y_true, y_pred)
metrics['tp'] = int(cm[1,1]) if cm.shape[0] > 1 else 0
metrics['tn'] = int(cm[0,0])
metrics['fp'] = int(cm[0,1]) if cm.shape[0] > 1 else 0
metrics['fn'] = int(cm[1,0]) if cm.shape[1] > 1 else 0

print(f"\n### Validation Metrics")
print(f"| Metric | Training | Validation |")
print(f"|--------|----------|------------|")
for k in ['accuracy', 'precision', 'recall', 'f1', 'auc']:
    train_val = training_metrics.get(k)
    val_val = metrics.get(k)
    if train_val is not None and val_val is not None:
        train_str = f"{train_val:.4f}"
        val_str = f"{val_val:.4f}"
        print(f"| {k.capitalize()} | {train_str} | {val_str} |")

print(f"\n**Samples tested:** {metrics['n_samples']}")

# Plots
import seaborn as sns
fig, axes = plt.subplots(1, 2, figsize=(12, 5))

# ROC Curve
if y_pred_proba is not None:
    fpr, tpr, _ = roc_curve(y_true, y_pred_proba)
    roc_auc = auc(fpr, tpr)
    axes[0].plot(fpr, tpr, color='darkorange', lw=2, label=f'ROC (AUC = {roc_auc:.3f})')
    axes[0].plot([0, 1], [0, 1], color='navy', lw=2, linestyle='--')
    axes[0].set_xlim([0.0, 1.0])
    axes[0].set_ylim([0.0, 1.05])
    axes[0].set_xlabel('False Positive Rate')
    axes[0].set_ylabel('True Positive Rate')
    axes[0].set_title('ROC Curve - External Validation')
    axes[0].legend(loc='lower right')
    axes[0].grid(True, alpha=0.3)

# Confusion Matrix Heatmap
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', ax=axes[1],
            xticklabels=['Pred 0', 'Pred 1'], yticklabels=['Actual 0', 'Actual 1'])
axes[1].set_xlabel('Predicted')
axes[1].set_ylabel('Actual')
axes[1].set_title('Confusion Matrix')

plt.tight_layout()
save_plot('ext_val')

# JSON metrics
output_metrics = {
    "model_type": "external_validation",
    "target": target_col,
    "training_features": features,
    "validation_metrics": metrics,
    "model_path": model_path
}

print("\n<!-- JSON_METRICS_START -->")
print(json.dumps(output_metrics, indent=2))
print("<!-- JSON_METRICS_END -->")