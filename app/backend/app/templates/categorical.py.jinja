elif n_rows == 2 and n_cols == 2:
    odds_ratio, p_value = fisher_exact(ct)
    test_name = "Fisher's Exact Test"
    test_reason = f"Minimum expected frequency ({min_expected:.2f}) < 5 (2x2 table)"
    
    print("### Fisher's Exact Test\n")
    print(f"**Test selected:** {test_name}")
    print(f"**Reason:** {test_reason}")
    print(f"**Odds Ratio = {odds_ratio:.3f}**, **p = {fmt_p(p_value)}**")
    
    if p_value < 0.001:
        sig = "***"
    elif p_value < 0.01:
        sig = "**"
    elif p_value < 0.05:
        sig = "*"
    else:
        sig = ""
    
    print(f"\n**Result:** p {sig}= {fmt_p(p_value)}")
    if p_value < 0.05:
        print("**Conclusion:** Statistically significant association between variables.")
        print(f"\n**Odds Ratio interpretation:**")
        row0, row1 = ct.index[0], ct.index[1]
        col0, col1 = ct.columns[0], ct.columns[1]
        if odds_ratio > 1:
            print(f"  Odds of `{col1}` (vs `{col0}`) in `{row1}` are {odds_ratio:.2f}x the odds in `{row0}`")
        else:
            print(f"  Odds of `{col1}` (vs `{col0}`) in `{row1}` are {1/odds_ratio:.2f}x lower than in `{row0}`")
    else:
        print("**Conclusion:** No statistically significant association.")

else:
    n_iterations = 10000
    chi2, p_value, dof, expected_df = chi2_contingency(ct, lambda_=None)
    
    observed = ct.values
    row_sums = observed.sum(axis=1)
    col_sums = observed.sum(axis=0)
    total = observed.sum()
    expected = np.outer(row_sums, col_sums) / total
    
    simulated_chi2 = []
    np.random.seed(42)
    
    for _ in range(n_iterations):
        simulated = np.random.multinomial(total, expected.flatten() / total).reshape(observed.shape)
        sim_expected = np.outer(simulated.sum(axis=1), simulated.sum(axis=0)) / total
        sim_expected = np.where(sim_expected == 0, 1e-10, sim_expected)
        sim_chi2 = ((simulated - sim_expected) ** 2 / sim_expected).sum()
        simulated_chi2.append(sim_chi2)
    
    simulated_chi2 = np.array(simulated_chi2)
    mc_p_value = (simulated_chi2 >= chi2).sum() / n_iterations
    
    test_name = "Monte Carlo Simulation"
    test_reason = f"Minimum expected frequency ({min_expected:.2f}) < 5, table is {n_rows}x{n_cols}"
    
    print(f"### {test_name}\n")
    print(f"**Test selected:** {test_name}")
    print(f"**Reason:** {test_reason}")
    print(f"**Iterations:** {n_iterations:,}")
    print(f"**Chi² = {chi2:.3f}**, df = {dof}")
    print(f"**Monte Carlo p = {fmt_p(mc_p_value)}**")
    
    if mc_p_value < 0.001:
        sig = "***"
    elif mc_p_value < 0.01:
        sig = "**"
    elif mc_p_value < 0.05:
        sig = "*"
    else:
        sig = ""
    
    print(f"\n**Result:** p {sig}= {fmt_p(mc_p_value)} (Monte Carlo, {n_iterations:,} iterations)")
    if mc_p_value < 0.05:
        print("**Conclusion:** Statistically significant association between variables.")
    else:
        print("**Conclusion:** No statistically significant association.")
    print("\n**Note:** p-value obtained via Monte Carlo simulation (10,000 iterations) due to small expected frequencies.")

