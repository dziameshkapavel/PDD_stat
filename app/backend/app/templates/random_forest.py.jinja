    print(f"**Target encoded:** {le.classes_.tolist()}  ")

is_binary = len(set(y)) == 2
auc = None
brier = None
brier_null = None
cal_intercept = None
cal_slope = None
print(f"**Observations:** {len(X)}  ")
print(f"**Features:** {X.shape[1]}  ")
print(f"**Task type:** {'binary' if is_binary else 'multiclass'}  \n")

rf_warnings = []

# RF-101: Class imbalance detection
if is_binary:
    class_counts = pd.Series(y).value_counts()
    minority_class = class_counts.min()
    majority_class = class_counts.max()
    minority_pct = minority_class / len(y) * 100
    majority_pct = majority_class / len(y) * 100
    print(f"**Class distribution:** {class_counts.to_dict()}")
    print(f"**Minority class:** {minority_pct:.1f}% / **Majority class:** {majority_pct:.1f}%  ")
    if minority_pct < 20:
        msg = f"Class imbalance detected: minority class = {minority_pct:.1f}% (< 20%). class_weight='balanced' is set, but predictions may still favor the majority class."
        print(f"⚠ {msg}\n")
        rf_warnings.append(msg)
    print()
else:
    print(f"**Class distribution:** {pd.Series(y).value_counts().to_dict()}\n")

# RF-105: Low event count warning
if is_binary:
    n_events = int(minority_class)
    if n_events < 20:
        msg = f"Low event count: {n_events} events. RF results may be unstable."
        print(f"⚠ {msg}\n")
        rf_warnings.append(msg)
elif len(y) < 50:
    msg = f"Small sample: {len(y)} observations for {X.shape[1]} features. RF results may be unstable."
    print(f"⚠ {msg}\n")
    rf_warnings.append(msg)

# Medical disclaimer
print("**Note:** Random Forest feature importance does not imply causal or independent association.")
print("  RF is an exploratory model; confirmatory analysis requires dedicated inferential methods.\n")

# Разделение
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42, stratify=y if is_binary else None
)

print(f"**Training set:** {len(X_train)}  ")
print(f"**Test set:** {len(X_test)}  \n")

# RF-108: Enhanced leakage detection
if is_binary:
    for col in valid_cov:
        col_lower = col.lower()
        if target.lower() in col_lower and col_lower != target.lower():
            if any(p in col_lower for p in ['event', 'status', 'outcome', 'death', 'survival', 'response']):
                msg = f"Potential data leakage: '{col}' contains target-related keywords. Consider excluding it."
                print(f"⚠ {msg}\n")
                rf_warnings.append(msg)
    # Check for unrealistically high AUC via perfect separation
    from sklearn.tree import DecisionTreeClassifier
    dt = DecisionTreeClassifier(max_depth=3, random_state=42)
    dt.fit(X_train, y_train)
    dt_proba = dt.predict_proba(X_test)[:, 1]
    if is_binary and len(set(y_test)) == 2:
        from sklearn.metrics import roc_auc_score
        dt_auc = roc_auc_score(y_test, dt_proba)
        if dt_auc > 0.98:
            msg = f"Near-perfect AUC ({dt_auc:.3f}) detected with shallow tree. Possible data leakage — review predictors."
            print(f"⚠ {msg}\n")
            rf_warnings.append(msg)

# Обучение
print("Training Random Forest model...\n")
rf = RandomForestClassifier(
    n_estimators=200,
    max_depth=10,
    min_samples_leaf=5,
    oob_score=True,
    random_state=42,
    n_jobs=-1,
    class_weight='balanced'
)
rf.fit(X_train, y_train)

# Метрики
