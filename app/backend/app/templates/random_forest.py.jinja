    col_lower = col.lower()
    if any(p in col_lower for p in ['_event', 'event_', '_time', 'time_', 'predicted_', '_prob', 'censored', 'followup', 'cox_', 'logistic_']):
        auto_exclude.append(col)
auto_exclude = list(set(auto_exclude))

# Все исключения вместе
all_exclude = set(auto_exclude + user_exclusions)

all_numeric = [c for c in df.columns if c != target and pd.api.types.is_numeric_dtype(df[c]) and c not in all_exclude]

print(f"**Covariates:** all numeric ({len(all_numeric)})")
if all_exclude:
