# SHAP анализ
if calculate_shap:
    try:
        import shap
        print("\n### SHAP Analysis\n")
        
        # Создаём объяснитель
        explainer = shap.TreeExplainer(rf)
        
        # Выбираем подвыборку для ускорения
        if len(X_test) > 100:
            X_shap = X_test.sample(100, random_state=42)
        else:
            X_shap = X_test
        
        shap_values = explainer.shap_values(X_shap)
        
        # Обработка разных форматов shap_values
        # 1. shap_values может быть списком (для старых версий shap)
        # 2. numpy массивом：新ый формат (n_samples, n_features, n_classes) или старый (n_classes, n_samples, n_features)
        if isinstance(shap_values, list):
            if is_binary:
                shap_vals = shap_values[1]  # класс 1
            else:
                shap_vals = shap_values
        elif isinstance(shap_values, np.ndarray):
            shape_len = len(shap_values.shape)
            if shape_len == 3:
                # Определяем формат: (n_samples, n_features, n_classes) или (n_classes, n_samples, n_features)
                n_classes_dim = shap_values.shape[2] if shap_values.shape[2] < 10 else shap_values.shape[0]
                if n_classes_dim <= 2:
                    # (n_samples, n_features, n_classes) - новый формат
                    shap_vals = shap_values[:, :, 1] if is_binary else shap_values.mean(axis=2)
                else:
                    # (n_classes, n_samples, n_features) - старый формат
                    shap_vals = shap_values[1] if is_binary else shap_values.mean(axis=0)
            else:
                shap_vals = shap_values
        else:
            shap_vals = shap_values
        
        print(f"shap_vals shape: {shap_vals.shape}")
        
        # SHAP Bar Plot
        plt.close('all')  # Очищаем предыдущие фигуры
        shap.summary_plot(shap_vals, X_shap, plot_type="bar", show=False)
        fig = plt.gcf()
        fig.set_size_inches(10, 6)
        save_plot(f"rf_shap_bar_{timestamp}", fig)
        plt.close('all')
        print(f"\n![SHAP Bar](/plots/rf_shap_bar_{timestamp}.png)\n")
        
        # 4. Топ SHAP признаки в таблице
        shap_importance = np.abs(shap_vals).mean(axis=0)
        shap_df = pd.DataFrame({
            'Feature': X_shap.columns,
            'SHAP Importance': shap_importance
        }).sort_values('SHAP Importance', ascending=False).head(top_n if top_n > 0 else 15)
        
        shap_metrics = [
            {"feature": str(row['Feature']), "importance": float(row['SHAP Importance'])}
            for _, row in shap_df.iterrows()
        ][:10]
        
        print(f"\n### Top-{len(shap_df)} SHAP features\n")
        print("| # | Feature | SHAP Importance |")
        print("|---|---------|-----------------|")
        for i, (_, row) in enumerate(shap_df.iterrows(), 1):
            print(f"| {i} | {row['Feature']} | {row['SHAP Importance']:.4f} |")
            
    except Exception as e:
        print(f"\n**SHAP analysis failed:** {e}")
        print("*Try installing shap: `pip install shap`*\n")
