print(f"| Metric | Value |")
print(f"|--------|-------|")
print(f"| OOB Score | {rf.oob_score_:.4f} |")

y_pred = rf.predict(X_test)
print(f"| Accuracy | {accuracy_score(y_test, y_pred):.4f} |")

if is_binary:
    print(f"| Precision | {precision_score(y_test, y_pred, average='binary', zero_division=0):.4f} |")
    print(f"| Recall | {recall_score(y_test, y_pred, average='binary'):.4f} |")
    print(f"| F1-score | {f1_score(y_test, y_pred, average='binary'):.4f} |")
    
    y_proba = rf.predict_proba(X_test)[:, 1]
    auc = roc_auc_score(y_test, y_proba)
    print(f"| **AUC** | **{auc:.4f}** |")
    
    # RF-102: Calibration metrics
    from sklearn.metrics import brier_score_loss
    from sklearn.isotonic import IsotonicRegression
    from scipy import stats
    brier = brier_score_loss(y_test, y_proba)
    print(f"| **Brier score** | **{brier:.4f}** |")
    print()
    print(f"**Brier score:** {brier:.4f} (0=perfect, >0.25=poor)")
    brier_null = (y_test.mean()) * (1 - y_test.mean())
    print(f"**Brier null model (always predict mean):** {brier_null:.4f}")
    print(f"**Brier skill score:** {1 - brier/brier_null:.4f} (1=perfect, 0=no better than mean)\n")
    
    # Calibration curve via isotonic regression
    iso_reg = IsotonicRegression(out_of_bounds='clip')
    iso_reg.fit(y_proba, y_test)
    calibrated_probs = iso_reg.predict(y_proba)
    from sklearn.linear_model import LogisticRegression
    logit_cal = LogisticRegression(solver='lbfgs')
    logit_cal.fit(y_proba.reshape(-1, 1), y_test)
    cal_intercept = float(logit_cal.intercept_[0])
    cal_slope = float(logit_cal.coef_[0][0])
    print(f"**Calibration intercept:** {cal_intercept:.4f} (0=perfect)")
    print(f"**Calibration slope:** {cal_slope:.4f} (1=perfect)")
    if abs(cal_intercept) > 0.5 or abs(cal_slope - 1) > 0.3:
        msg = f"Poor calibration: intercept={cal_intercept:.2f}, slope={cal_slope:.2f}. Predicted probabilities may be biased."
        print(f"⚠ {msg}\n")
        rf_warnings.append(msg)
    
    # Calibration plot
    from sklearn.calibration import calibration_curve
    prob_true, prob_pred = calibration_curve(y_test, y_proba, n_bins=10, strategy='uniform')
    fig_cal, ax_cal = plt.subplots(figsize=(8, 7))
    ax_cal.plot(prob_pred, prob_true, marker='o', linewidth=2, label='RF')
    ax_cal.plot([0, 1], [0, 1], 'k--', linewidth=1, label='Perfect')
    ax_cal.set_xlabel('Mean predicted probability')
    ax_cal.set_ylabel('Observed proportion')
    ax_cal.set_title('Calibration Plot')
    ax_cal.legend()
    ax_cal.grid(True, alpha=0.3)
