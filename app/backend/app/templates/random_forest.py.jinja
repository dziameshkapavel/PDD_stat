                'auc': float(auc) if is_binary else None,
                'precision': float(precision_score(y_test, y_pred, average='binary', zero_division=0)) if is_binary else None,
                'recall': float(recall_score(y_test, y_pred, average='binary')) if is_binary else None,
                'f1': float(f1_score(y_test, y_pred, average='binary')) if is_binary else None,
                'sensitivity': float(recall_score(y_test, y_pred, average='binary')) if is_binary else None,
                'specificity': float(((y_test == 0) & (y_pred == 0)).sum() / (y_test == 0).sum()) if is_binary and (y_test == 0).sum() > 0 else None
            },
            'training_date': datetime.now().isoformat()
        }
        model_name = "rf_model_" + str(int(timestamp)) + ".joblib"
        model_path = Path(project_path) / model_name
        joblib.dump(model_bundle, str(model_path))
        saved_model_path = str(model_path)
