        # Обработка разных форматов shap_values
        # 1. shap_values может быть списком (для старых версий shap)
        # 2. numpy массивом：新ый формат (n_samples, n_features, n_classes) или старый (n_classes, n_samples, n_features)
        if isinstance(shap_values, list):
            if is_binary:
                shap_vals = shap_values[1]  # класс 1
            else:
                shap_vals = shap_values
        elif isinstance(shap_values, np.ndarray):
            shape_len = len(shap_values.shape)
            if shape_len == 3:
                # Определяем формат: (n_samples, n_features, n_classes) или (n_classes, n_samples, n_features)
                n_classes_dim = shap_values.shape[2] if shap_values.shape[2] < 10 else shap_values.shape[0]
                if n_classes_dim <= 2:
                    # (n_samples, n_features, n_classes) - новый формат
                    shap_vals = shap_values[:, :, 1] if is_binary else shap_values.mean(axis=2)
                else:
                    # (n_classes, n_samples, n_features) - старый формат
                    shap_vals = shap_values[1] if is_binary else shap_values.mean(axis=0)
            else:
                shap_vals = shap_values
        else:
            shap_vals = shap_values
        
