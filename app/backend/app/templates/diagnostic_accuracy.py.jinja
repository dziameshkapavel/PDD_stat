            mask_d = (ref == 1)
            b = ((p1[mask_d] == 0) & (p2[mask_d] == 1)).sum()
            c = ((p1[mask_d] == 1) & (p2[mask_d] == 0)).sum()
            chi2_sens, p_sens = mcnemar_test(b, c)
            mask_nd = (ref == 0)
