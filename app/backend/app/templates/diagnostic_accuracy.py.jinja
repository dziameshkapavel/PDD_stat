            # Discordant pairs among diseased (ref=1)
            mask_d = (ref == 1)
            b = ((p1[mask_d] == 0) & (p2[mask_d] == 1)).sum()  # FN test1, TP test2
            c = ((p1[mask_d] == 1) & (p2[mask_d] == 0)).sum()  # TP test1, FN test2
            chi2_sens, p_sens = mcnemar_test(b, c)
            # Among non-diseased (ref=0)
            mask_nd = (ref == 0)
            b_spec = ((p1[mask_nd] == 1) & (p2[mask_nd] == 0)).sum()  # FP test1, TN test2
            c_spec = ((p1[mask_nd] == 0) & (p2[mask_nd] == 1)).sum()  # TN test1, FP test2
            chi2_spec, p_spec = mcnemar_test(b_spec, c_spec)
            pairwise_tests.append({
                "test1": t1, "test2": t2,
                "sens_chi2": chi2_sens, "sens_p": p_sens,
                "spec_chi2": chi2_spec, "spec_p": p_spec,
                "discordant_sens": f"{b} vs {c}",
                "discordant_spec": f"{b_spec} vs {c_spec}"
            })

