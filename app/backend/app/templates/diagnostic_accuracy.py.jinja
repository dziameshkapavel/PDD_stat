def calc_metrics(tp, fp, fn, tn):
    sens = tp / (tp + fn) if (tp + fn) > 0 else np.nan
    spec = tn / (tn + fp) if (tn + fp) > 0 else np.nan
    ppv = tp / (tp + fp) if (tp + fp) > 0 else np.nan
    npv = tn / (tn + fn) if (tn + fn) > 0 else np.nan
    acc = (tp + tn) / (tp + tn + fp + fn) if (tp + tn + fp + fn) > 0 else np.nan
    lr_pos = sens / (1 - spec) if (1 - spec) > 0 else np.inf
    lr_neg = (1 - sens) / spec if spec > 0 else np.inf
    dor = (tp * tn) / (fp * fn) if (fp * fn) > 0 else np.inf
    return sens, spec, ppv, npv, acc, lr_pos, lr_neg, dor

def wilson_ci(prop, n):
    if n == 0:
        return np.nan, np.nan
    z = norm.ppf(0.975)
    denominator = 1 + z**2 / n
    centre = (prop + z**2 / (2 * n)) / denominator
    margin = z * np.sqrt((prop * (1 - prop) + z**2 / (4 * n)) / n) / denominator
    return max(0, centre - margin), min(1, centre + margin)

def lr_ci(lr, tp, fp, fn, tn):
    # Approximate CI for LR+ and LR-
    if lr <= 0 or np.isinf(lr):
        return np.nan, np.nan
    if lr > 1:
        se = np.sqrt(1/tp - 1/(tp+fp) + 1/fn - 1/(fn+tn)) if tp>0 and fn>0 else np.nan
    else:
        se = np.sqrt(1/fp - 1/(tp+fp) + 1/tn - 1/(fn+tn)) if fp>0 and tn>0 else np.nan
    if np.isnan(se):
        return np.nan, np.nan
    ci_low = np.exp(np.log(lr) - 1.96 * se)
    ci_high = np.exp(np.log(lr) + 1.96 * se)
    return ci_low, ci_high

def mcnemar_test(b, c):
    # b: FN for test1, TP for test2 (discordant pairs)
    # c: FP for test1, TN for test2
    if b + c == 0:
        return 1.0, 0.0
    chi2_val = (abs(b - c) - 1)**2 / (b + c) if (b + c) > 0 else 0
    p = 1 - chi2.cdf(chi2_val, 1)
    return chi2_val, p

