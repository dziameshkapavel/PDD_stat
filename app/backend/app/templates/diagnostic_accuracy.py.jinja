for test in valid_tests:
    data = df[[target_col, test]].dropna()
    n_dropped = len(df) - len(data)
    if n_dropped > 0:
        print(f"⚠️ Removed {n_dropped} rows ({n_dropped/len(df)*100:.1f}%) with missing data for test `{test}`")
    ref_raw = data[target_col]
    if ref_raw.dtype == object:
        uniq_ref = sorted(ref_raw.unique())
        ref = ref_raw.map({v: i for i, v in enumerate(uniq_ref)}).astype(int)
    else:
        ref = ref_raw.astype(int)
    pred_raw = data[test]
    if pred_raw.dtype == object:
        uniq_pred = sorted(pred_raw.unique())
        pred = pred_raw.map({v: i for i, v in enumerate(uniq_pred)}).astype(int)
    else:
        pred = pred_raw.astype(int)

    tp = ((pred == 1) & (ref == 1)).sum()
    fp = ((pred == 1) & (ref == 0)).sum()
    fn = ((pred == 0) & (ref == 1)).sum()
    tn = ((pred == 0) & (ref == 0)).sum()
    n = len(data)

    sens, spec, ppv, npv, acc, lr_pos, lr_neg, dor = calc_metrics(tp, fp, fn, tn)
    sens_ci = wilson_ci(sens, tp + fn)
    spec_ci = wilson_ci(spec, tn + fp)
    ppv_ci = wilson_ci(ppv, tp + fp)
    npv_ci = wilson_ci(npv, tn + fn)
    acc_ci = wilson_ci(acc, n)
    lr_pos_ci = lr_ci(lr_pos, tp, fp, fn, tn)
    lr_neg_ci = lr_ci(lr_neg, tp, fp, fn, tn)

    results.append({
        "test": test,
        "tp": int(tp), "fp": int(fp), "fn": int(fn), "tn": int(tn),
        "n": n,
