        "specificity": spec, "specificity_ci_low": spec_ci[0], "specificity_ci_high": spec_ci[1],
        "ppv": ppv, "ppv_ci_low": ppv_ci[0], "ppv_ci_high": ppv_ci[1],
        "npv": npv, "npv_ci_low": npv_ci[0], "npv_ci_high": npv_ci[1],
        "accuracy": acc, "accuracy_ci_low": acc_ci[0], "accuracy_ci_high": acc_ci[1],
        "lr_pos": lr_pos, "lr_pos_ci_low": lr_pos_ci[0], "lr_pos_ci_high": lr_pos_ci[1],
        "lr_neg": lr_neg, "lr_neg_ci_low": lr_neg_ci[0], "lr_neg_ci_high": lr_neg_ci[1],
        "dor": dor
    })

# Pairwise McNemar
if len(valid_tests) > 1:
