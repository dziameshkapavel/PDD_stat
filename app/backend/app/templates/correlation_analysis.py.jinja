        {"var1": v1, "var2": v2, "r": float(r), "p_value": float(p)}
        for v1, v2, r, p in pairs[:10]
    ]
}

def make_json_serializable(obj):
    if isinstance(obj, dict):
        return {str(k): make_json_serializable(v) for k, v in obj.items()}
    elif isinstance(obj, (list, tuple)):
        return [make_json_serializable(item) for item in obj]
    elif isinstance(obj, (np.integer, np.int64)):
        return int(obj)
    elif isinstance(obj, (np.floating, np.float64)):
        return float(obj) if not np.isnan(obj) else None
    return obj

output_metrics = make_json_serializable(output_metrics)

print("\n<!-- JSON_METRICS_START -->")
print(json.dumps(output_metrics, ensure_ascii=False))
print("<!-- JSON_METRICS_END -->")
