                            w_msg = f"Time {t}mo: unstable AUC (risk set={a['risk_set']}, events={a['events']}) for {m}"
                            surv_warnings.append(w_msg)
                        elif a['auc'] is not None:
                            p = a.get('p_value')
                            if p is not None:
                                row += f" {a['auc']:.3f} [{a['ci_low']:.3f}-{a['ci_high']:.3f}] |"
                            else:
                                row += f" {a['auc']:.3f} [{a['ci_low']:.3f}-{a['ci_high']:.3f}] |"
                        else:
                            row += " — |"
                    else:
                        row += " — |"
                print(row)
        print()
    else:
        print("*No time points specified. Enter values (e.g., 12,24,36) in the field above.*\n")

    for m, auc_d in auc_data.items():
        key = f"{label}|{m}"
        all_auc_plot_data[key] = {'data': auc_d, 'label': label, 'model': m, 'times': local_times}

# Model comparison
if run_model_comparison and len(valid_preds) >= 2 and len(strata) == 1:
    n_comp = len(valid_preds) * (len(valid_preds) - 1) // 2
    print("### Model Comparison\n")
    if n_comp > 1:
        print(f"*{n_comp} pairwise comparisons. Multiple comparisons inflate Type I error.*\n")
    print("*Note: Exploratory comparison using bootstrap delta C. IPCW-based tests (e.g., Uno test) recommended for confirmatory analysis.*\n")
    y_all_time = df_eval[time_col].values
    y_all_event = df_eval[event_col].values.astype(bool)
    y_all_surv = Surv.from_arrays(event=y_all_event, time=y_all_time)

    for m1, m2 in combinations(valid_preds, 2):
        c1 = calc_cindex(y_all_event, y_all_time, df_eval[m1].values)
        c2 = calc_cindex(y_all_event, y_all_time, df_eval[m2].values)
        delta = c1 - c2

        # Boostrap percentile CI for delta C
        n_boot_test = min(n_bootstrap, 500)
        boot_deltas = []
        np.random.seed(bootstrap_seed)
        for _ in range(n_boot_test):
            idx = np.random.choice(len(y_all_event), len(y_all_event), replace=True)
            if y_all_event[idx].sum() == 0:
                continue
            try:
                cb1 = calc_cindex(y_all_event[idx], y_all_time[idx], df_eval[m1].values[idx])
                cb2 = calc_cindex(y_all_event[idx], y_all_time[idx], df_eval[m2].values[idx])
                boot_deltas.append(cb1 - cb2)
            except:
                continue

        if boot_deltas:
            boot_deltas = np.array(boot_deltas)
            delta_ci_low = float(np.percentile(boot_deltas, 2.5))
            delta_ci_high = float(np.percentile(boot_deltas, 97.5))
            p_val = (2.0 * min(np.sum(boot_deltas <= 0), np.sum(boot_deltas >= 0)) + 1.0) / (len(boot_deltas) + 1.0)
            if p_val > 1.0:
                p_val = 1.0
        else:
            delta_ci_low, delta_ci_high, p_val = delta, delta, 1.0

        sig = "**" if p_val < 0.05 else ""
        print(f"| {m1} vs {m2} | ΔC = {delta:+.4f} [{delta_ci_low:.4f}, {delta_ci_high:.4f}] | p = {fmt_p(p_val)}{sig} |")
        model_comparisons.append({'model1': m1, 'model2': m2, 'delta': float(delta), 'delta_ci_low': float(delta_ci_low), 'delta_ci_high': float(delta_ci_high), 'p_value': float(p_val)})
    print()

