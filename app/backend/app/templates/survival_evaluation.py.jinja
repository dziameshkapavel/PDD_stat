# ========== HELPER FUNCTIONS ==========
def concordance_index(y_event, y_time, risk):
    """C-index with handling for edge cases"""
    from sksurv.metrics import concordance_index_censored
    try:
        c_idx = concordance_index_censored(y_event, y_time, risk)[0]
        return float(c_idx)
    except:
        return 0.5

def bootstrap_ci_cindex(y_event, y_time, risk, n_iter=1000, alpha=0.05):
    """Bootstrap CI for C-index with BCa correction"""
    n = len(y_event)
    base_c = concordance_index(y_event, y_time, risk)
    boot_c = []
    
    np.random.seed(42)
    for _ in range(n_iter):
        idx = np.random.choice(n, n, replace=True)
        y_e_boot = y_event[idx]
        y_t_boot = y_time[idx]
        risk_boot = risk[idx]
        
        if y_e_boot.sum() == 0 or y_e_boot.sum() == len(y_e_boot):
            continue
            
        try:
            c_boot = concordance_index(y_e_boot, y_t_boot, risk_boot)
            if not np.isnan(c_boot):
                boot_c.append(c_boot)
        except:
            continue
    
    if len(boot_c) < 50:
        return base_c, base_c, base_c
    
    boot_c = np.array(boot_c)
    
    # BCa correction
    z0 = stats.norm.ppf((boot_c < base_c).mean())
    
    # Acceleration factor
    jack_c = []
    for i in range(min(n, 100)):
        idx_jack = np.ones(n, dtype=bool)
        idx_jack[i] = False
        try:
            c_jack = concordance_index(y_event[idx_jack], y_time[idx_jack], risk[idx_jack])
            jack_c.append(c_jack)
        except:
            continue
    
    if jack_c:
        jack_c = np.array(jack_c)
        jack_mean = jack_c.mean()
        a = np.sum((jack_mean - jack_c)**3) / (6 * (np.sum((jack_mean - jack_c)**2))**1.5)
        a = np.clip(a, -1, 1) if not np.isnan(a) else 0
    else:
        a = 0
    
    z_alpha = stats.norm.ppf(alpha / 2)
    z_1_alpha = stats.norm.ppf(1 - alpha / 2)
    
    # BCa percentiles
    p_low = stats.norm.cdf(z0 + (z0 + z_alpha) / (1 - a * (z0 + z_alpha)))
    p_high = stats.norm.cdf(z0 + (z0 + z_1_alpha) / (1 - a * (z0 + z_1_alpha)))
    
    ci_low = np.percentile(boot_c, max(0.1, p_low * 100))
    ci_high = np.percentile(boot_c, min(99.9, p_high * 100))
    
    return float(base_c), float(ci_low), float(ci_high)

def time_dependent_auc_bootstrap(y_surv, risk, time_points, n_iter=500):
    """Time-dependent AUC with bootstrap CI"""
    from sksurv.metrics import cumulative_dynamic_auc
    
    n = len(risk)
    auc_results = {}
    
    for t in time_points:
        if t <= 0 or t > y_time.max():
            continue
            
        # Point estimate
        try:
            # Split for stable estimate
            ev_idx = np.where(y_event)[0]
            ne_idx = np.where(~y_event)[0]
            
            n_ev_train = len(ev_idx) // 2
            n_ne_train = len(ne_idx) // 2
            
            train_idx = np.concatenate([ev_idx[:n_ev_train], ne_idx[:n_ne_train]])
            test_idx = np.concatenate([ev_idx[n_ev_train:], ne_idx[n_ne_train:]])
            
            auc_val = cumulative_dynamic_auc(
                y_surv[train_idx], y_surv[test_idx], risk[test_idx], [t]
            )
            base_auc = float(auc_val[0][0]) if isinstance(auc_val, tuple) else float(auc_val[0])
        except:
            continue
        
        # Bootstrap
        boot_aucs = []
        np.random.seed(42)
        for _ in range(min(n_iter, 200)):
            idx = np.random.choice(n, n, replace=True)
            y_s_boot = y_surv[idx]
            risk_boot = risk[idx]
            
            ev_idx_b = np.where(y_s_boot['event'])[0]
            ne_idx_b = np.where(~y_s_boot['event'])[0]
            
            if len(ev_idx_b) < 5 or len(ne_idx_b) < 5:
                continue
            
            n_ev_tr = len(ev_idx_b) // 2
            n_ne_tr = len(ne_idx_b) // 2
            
            tr = np.concatenate([ev_idx_b[:n_ev_tr], ne_idx_b[:n_ne_tr]])
            te = np.concatenate([ev_idx_b[n_ev_tr:], ne_idx_b[n_ne_tr:]])
            
            try:
                auc_b = cumulative_dynamic_auc(y_s_boot[tr], y_s_boot[te], risk_boot[te], [t])
                v = float(auc_b[0][0]) if isinstance(auc_b, tuple) else float(auc_b[0])
                if not np.isnan(v):
                    boot_aucs.append(v)
            except:
                continue
        
        if boot_aucs:
            auc_results[t] = {
                'auc': base_auc,
                'ci_low': float(np.percentile(boot_aucs, 2.5)),
                'ci_high': float(np.percentile(boot_aucs, 97.5))
            }
    
    return auc_results

def integrated_brier_score_wrapper(y_surv, risk, eval_times):
    """Integrated Brier Score"""
    from sksurv.metrics import integrated_brier_score
    try:
        ibs = integrated_brier_score(y_surv, y_surv, risk, eval_times)
        return float(ibs)
    except:
        return None

