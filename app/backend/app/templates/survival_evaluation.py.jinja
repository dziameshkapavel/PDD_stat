    _min_t = max(6, int(local_y_time.min()))
    _max_t = int(local_y_time.max())
    local_times = list(range(_min_t, _max_t + 6, 6))
    if not local_times:
        local_times = [_max_t]

    c_indices = {}
    auc_data = {}

    for pred_col in valid_preds:
        risk = stratum_df[pred_col].values

        if n_bootstrap > 0:
            c_val, ci_low, ci_high, c_uno, uno_low, uno_high = bootstrap_cindex(
                local_y_event, local_y_time, risk, local_y_surv, n_bootstrap
            )
        else:
            c_val = calc_cindex(local_y_event, local_y_time, risk)
            ci_low, ci_high = c_val, c_val
            c_uno = calc_uno_cindex(local_y_event, local_y_time, risk, local_y_surv)
            uno_low, uno_high = c_uno, c_uno if c_uno is not None else None

        c_indices[pred_col] = {'value': c_val, 'ci_low': ci_low, 'ci_high': ci_high, 'uno': c_uno, 'uno_low': uno_low, 'uno_high': uno_high}
        auc_data[pred_col] = calc_time_auc_bootstrap(local_y_surv, risk, local_times, local_y_event, local_y_time, min(500, n_bootstrap))

    results_by_stratum.append({
        'label': label,
        'n': len(stratum_df),
        'events': int(local_y_event.sum()),
        'c_indices': c_indices,
        'auc_data': auc_data
    })

    print(f"### Stratum: {label} (n={len(stratum_df)}, events={int(local_y_event.sum())})\n")

    print("**Harrell C-index**")
    print("| Model | C-index | 95% CI |")
    print("|-------|---------|--------|")
    for m, c in c_indices.items():
        print(f"| {m} | {c['value']:.4f} | [{c['ci_low']:.4f}, {c['ci_high']:.4f}] |")
    print()

    print("**Uno C-index** (IPCW-corrected)")
    print("| Model | C-index | 95% CI |")
    print("|-------|---------|--------|")
    for m, c in c_indices.items():
        if c['uno'] is not None:
            print(f"| {m} | {c['uno']:.4f} | [{c['uno_low']:.4f}, {c['uno_high']:.4f}] |")
        else:
            print(f"| {m} | — | — |")
    print()

    # SURV-005: Per-time-point Brier score (IBS requires survival probabilities, not risk scores)
    risk_min, risk_max = stratum_df[valid_preds[0]].min(), stratum_df[valid_preds[0]].max()
    is_probability = 0 <= risk_min and risk_max <= 1
    if is_probability:
        print("**Time-dependent Brier Score** — lower is better")
        brier_times = [t for t in time_points if t > 0 and t <= local_y_time.max()] if time_points else [max(6, int(local_y_time.median()))]
        print("| Time | " + " | ".join([f"`{p}`" for p in valid_preds]) + " |")
        print("|------|" + "|".join(["----------" for _ in valid_preds]) + "|")
        for t in brier_times:
            row = f"| {t}mo |"
            for pred_col in valid_preds:
                risk = stratum_df[pred_col].values
                try:
                    bs_val = float(brier_score(local_y_surv, local_y_surv, risk, [t])[0][0])
                    ibs_all.append(bs_val)
                    row += f" {bs_val:.4f} |"
                except:
                    row += " — |"
            print(row)
        print()
    else:
        print("*IBS/Brier: predictions are not probabilities (not in [0,1]). Skipping.*\n")

    # SURV-006: Survival calibration at user-specified time points
    # Group predictions into quantiles and compare KM-observed vs predicted survival
    cal_times = [t for t in time_points if t > 0 and t <= local_y_time.max()] if time_points else []
    if cal_times:
        print("**Survival Calibration** (observed vs predicted by risk group)")
        print("| Time | Model | Group | N | Observed Surv |")
        print("|------|-------|-------|---|---------------|")
        for t in cal_times:
            for pred_col in valid_preds:
                risk = stratum_df[pred_col].values
                try:
                    from lifelines import KaplanMeierFitter
                    # Split into 3 groups by risk score tertiles
                    tertiles = [np.percentile(risk, 33.33), np.percentile(risk, 66.67)]
                    if tertiles[0] == tertiles[1]:
                        continue
                    groups = np.digitize(risk, tertiles)
                    for gi in range(1, 4):
                        gmask = groups == gi
                        if gmask.sum() < 5 or local_y_event[gmask].sum() < 1:
                            continue
                        kmf = KaplanMeierFitter()
                        kmf.fit(local_y_time[gmask], local_y_event[gmask])
                        obs_surv = kmf.predict(t)
                        gname = "High" if gi == 3 else ("Mid" if gi == 2 else "Low")
                        print(f"| {t}mo | {pred_col} | {gname} | {int(gmask.sum())} | {obs_surv:.3f} |")
                except:
                    continue
        print()

    times_to_show = time_points
