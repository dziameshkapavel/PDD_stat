# ========== 4. MODEL COMPARISON ==========
if run_model_comparison and len(valid_preds) >= 2:
    print("### Model Comparison (IPCW-based DeLong test)\n")
    
    for m1, m2 in combinations(valid_preds, 2):
        risk1 = df_eval[m1].values
        risk2 = df_eval[m2].values
        
        # IPCW weights for censoring
        try:
            from lifelines import KaplanMeierFitter
            
            # Fit censoring model
            kmf = KaplanMeierFitter()
            kmf.fit(y_time, ~y_event)  # censoring survival
            
            # Get IPCW weights
            ipcw = np.zeros(len(y_time))
            for i in range(len(y_time)):
                t_i = y_time[i]
                s_c = kmf.survival_function_at_times([t_i]).values[0]
                if s_c > 0.01:
                    ipcw[i] = 1.0 / s_c
                else:
                    ipcw[i] = 0
            
            # Normalize weights
            ipcw = ipcw / ipcw.sum() * len(ipcw)
            
            # Compute weighted AUC for each model
            from sklearn.metrics import roc_auc_score
            
            c1 = concordance_index(y_event, y_time, risk1)
            c2 = concordance_index(y_event, y_time, risk2)
            
            delta = c1 - c2
            
            # Bootstrap test statistic
            n_boot_test = min(n_bootstrap, 500)
            boot_deltas = []
            
            np.random.seed(42)
            for _ in range(n_boot_test):
                idx = np.random.choice(len(y_event), len(y_event), replace=True)
                y_e_b = y_event[idx]
                y_t_b = y_time[idx]
                r1_b = risk1[idx]
                r2_b = risk2[idx]
                
                if y_e_b.sum() == 0:
                    continue
                
                try:
                    c1_b = concordance_index(y_e_b, y_t_b, r1_b)
                    c2_b = concordance_index(y_e_b, y_t_b, r2_b)
                    boot_deltas.append(c1_b - c2_b)
                except:
                    continue
            
            if boot_deltas:
                boot_deltas = np.array(boot_deltas)
                se_delta = boot_deltas.std()
                z_stat = delta / se_delta if se_delta > 0 else 0
                p_val = 2 * (1 - stats.norm.cdf(abs(z_stat)))
            else:
                se_delta = 0
                z_stat = 0
                p_val = 1.0
            
            sig_mark = " **" if p_val < 0.05 else ""
            
            model_comparisons.append({
                'model1': m1,
                'model2': m2,
                'c_index_1': float(c1),
                'c_index_2': float(c2),
                'delta': float(delta),
                'z_statistic': float(z_stat),
                'p_value': float(p_val)
            })
            
            print(f"| {m1} vs {m2} | ΔC = {delta:+.4f} | z = {z_stat:.3f} | p = {p_val:.4f}{sig_mark} |")
        
        except Exception as e:
            print(f"| {m1} vs {m2} | Comparison failed: {e} |")
    
    print()

