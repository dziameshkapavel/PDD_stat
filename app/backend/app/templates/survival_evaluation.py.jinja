# ========== HELPERS ==========
from sksurv.util import Surv
from sksurv.metrics import concordance_index_censored, cumulative_dynamic_auc
from scipy import stats

def calc_cindex(y_ev, y_tm, risk):
    try:
        return float(concordance_index_censored(y_ev, y_tm, risk)[0])
    except:
        return 0.5

def bootstrap_cindex(y_ev, y_tm, risk, n_iter=1000):
    n = len(y_ev)
    base_c = calc_cindex(y_ev, y_tm, risk)
    boot_c = []
    np.random.seed(42)
    for _ in range(n_iter):
        idx = np.random.choice(n, n, replace=True)
        if y_ev[idx].sum() == 0 or y_ev[idx].sum() == len(y_ev[idx]):
            continue
        try:
            c = calc_cindex(y_ev[idx], y_tm[idx], risk[idx])
            if not np.isnan(c):
                boot_c.append(c)
        except:
            continue
    if len(boot_c) < 50:
        return base_c, base_c, base_c
    boot_c = np.array(boot_c)
    return float(base_c), float(np.percentile(boot_c, 2.5)), float(np.percentile(boot_c, 97.5))

def calc_time_auc(y_surv_local, risk, times, y_ev, y_tm):
    ev_idx = np.where(y_ev)[0]
    ne_idx = np.where(~y_ev)[0]
    if len(ev_idx) < 5 or len(ne_idx) < 5:
        return {}
    
    n_ev_train = len(ev_idx) // 2
    n_ne_train = len(ne_idx) // 2
    train_idx = np.concatenate([ev_idx[:n_ev_train], ne_idx[:n_ne_train]])
    test_idx = np.concatenate([ev_idx[n_ev_train:], ne_idx[n_ne_train:]])
    
    results = {}
    for t in times:
        if t <= 0 or t > y_tm.max():
            continue
        try:
            auc_val = cumulative_dynamic_auc(y_surv_local[train_idx], y_surv_local[test_idx], risk[test_idx], [t])
            base_auc = float(auc_val[0][0]) if isinstance(auc_val, tuple) else float(auc_val[0])
            results[t] = {'auc': base_auc}
        except:
            continue
    return results

