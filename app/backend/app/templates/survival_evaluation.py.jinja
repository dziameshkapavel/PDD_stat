# ========== HELPERS ==========
from sksurv.util import Surv
from sksurv.metrics import concordance_index_censored, cumulative_dynamic_auc
from scipy import stats

def calc_cindex(y_ev, y_tm, risk):
    try:
        return float(concordance_index_censored(y_ev, y_tm, risk)[0])
    except:
        return 0.5

def bootstrap_cindex(y_ev, y_tm, risk, n_iter=1000):
    n = len(y_ev)
    base_c = calc_cindex(y_ev, y_tm, risk)
    boot_c = []
    np.random.seed(42)
    for _ in range(n_iter):
        idx = np.random.choice(n, n, replace=True)
        if y_ev[idx].sum() == 0 or y_ev[idx].sum() == len(y_ev[idx]):
            continue
        try:
            c = calc_cindex(y_ev[idx], y_tm[idx], risk[idx])
            if not np.isnan(c):
                boot_c.append(c)
        except:
            continue
    if len(boot_c) < 50:
        return base_c, base_c, base_c
    boot_c = np.array(boot_c)
    return float(base_c), float(np.percentile(boot_c, 2.5)), float(np.percentile(boot_c, 97.5))

def calc_time_auc_bootstrap(y_surv_local, risk, times, y_ev, y_tm, n_iter=500):
    """Calculate time-dependent AUC with bootstrap out-of-bag"""
    n = len(y_ev)
    results = {}
    
    for t in times:
        if t <= 0 or t > y_tm.max():
            continue
        
        boot_aucs = []
        np.random.seed(42)
        
        for _ in range(n_iter):
            # Bootstrap sample
            idx_train = np.random.choice(n, n, replace=True)
            # Out-of-bag = not selected in bootstrap
            oob_mask = np.ones(n, dtype=bool)
            for i in idx_train:
                oob_mask[i] = False
            
            if oob_mask.sum() < 10:
                continue
            if y_ev[oob_mask].sum() < 2:
                continue
            
            try:
                # Train on bootstrap, test on OOB
                auc_val = cumulative_dynamic_auc(
                    y_surv_local[idx_train],   # train
                    y_surv_local[oob_mask],     # test (OOB)
                    risk[oob_mask],             # risk on test
                    [t]
                )
                val = float(auc_val[0][0]) if isinstance(auc_val, tuple) else float(auc_val[0])
                if 0.01 < val < 0.99:
                    boot_aucs.append(val)
            except:
                continue
        
        if len(boot_aucs) >= 50:
            boot_aucs = np.array(boot_aucs)
            mean_auc = float(boot_aucs.mean())
            se_auc = float(boot_aucs.std())
            z = (mean_auc - 0.5) / se_auc if se_auc > 0 else 0
            p_val = float(2 * (1 - stats.norm.cdf(abs(z))))
            results[t] = {
                'auc': mean_auc,
                'ci_low': float(np.percentile(boot_aucs, 2.5)),
                'ci_high': float(np.percentile(boot_aucs, 97.5)),
                'p_value': p_val
            }
        else:
            # Fallback: single estimate
            try:
                auc_val = cumulative_dynamic_auc(y_surv_local, y_surv_local, risk, [t])
                val = float(auc_val[0][0]) if isinstance(auc_val, tuple) else float(auc_val[0])
                results[t] = {'auc': val, 'ci_low': val, 'ci_high': val, 'p_value': None}
            except:
                continue
    
    return results

