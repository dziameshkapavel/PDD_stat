# ========== HELPERS ==========
from sksurv.util import Surv
from sksurv.metrics import (
    concordance_index_censored,
    concordance_index_ipcw,
    cumulative_dynamic_auc,
    brier_score,
)
from scipy import stats
from sklearn.isotonic import IsotonicRegression

def calc_cindex(y_ev, y_tm, risk):
    try:
        return float(concordance_index_censored(y_ev, y_tm, risk)[0])
    except:
        return 0.5

def calc_uno_cindex(y_ev, y_tm, risk, y_all_surv):
    try:
        y_test_surv = Surv.from_arrays(event=y_ev, time=y_tm)
        return float(concordance_index_ipcw(y_all_surv, y_test_surv, risk)[0])
    except:
        return None

def bootstrap_cindex(y_ev, y_tm, risk, y_all_surv=None, n_iter=1000):
    """Returns Harrell C-index, Uno C-index, and bootstrap 95% CI for both."""
    n = len(y_ev)
    base_c = calc_cindex(y_ev, y_tm, risk)
    base_uno = calc_uno_cindex(y_ev, y_tm, risk, y_all_surv) if y_all_surv is not None else None
    boot_c = []
    boot_uno = []
    np.random.seed(bootstrap_seed)
    for _ in range(n_iter):
        idx = np.random.choice(n, n, replace=True)
        if y_ev[idx].sum() == 0 or y_ev[idx].sum() == len(y_ev[idx]):
            continue
        try:
            c = calc_cindex(y_ev[idx], y_tm[idx], risk[idx])
            if not np.isnan(c):
                boot_c.append(c)
        except:
            continue
        if y_all_surv is not None:
            try:
                u = calc_uno_cindex(y_ev[idx], y_tm[idx], risk[idx], y_all_surv)
                if u is not None and not np.isnan(u):
                    boot_uno.append(u)
            except:
                continue
    if len(boot_c) < 50:
        return base_c, base_c, base_c, base_uno, None, None
    boot_c = np.array(boot_c)
    ci_low = float(np.percentile(boot_c, 2.5))
    ci_high = float(np.percentile(boot_c, 97.5))
    uno_ci_low = None
    uno_ci_high = None
    if len(boot_uno) >= 50:
        boot_uno = np.array(boot_uno)
        uno_ci_low = float(np.percentile(boot_uno, 2.5))
        uno_ci_high = float(np.percentile(boot_uno, 97.5))
    return float(base_c), ci_low, ci_high, base_uno, uno_ci_low, uno_ci_high

def calc_time_auc_bootstrap(y_surv_local, risk, times, y_ev, y_tm, n_iter=500):
    n = len(y_ev)
    results = {}

    for t in times:
        if t <= 0 or t > y_tm.max():
            continue

        # SURV-004/007: Check risk set and events at this time point
        risk_set = (y_tm >= t).sum()
        events_at_t = (y_ev & (y_tm <= t)).sum()
        if risk_set < 10:
            results[t] = {'auc': None, 'ci_low': None, 'ci_high': None, 'p_value': None, 'risk_set': int(risk_set), 'events': int(events_at_t), 'unstable': True}
            continue

        boot_aucs = []
        np.random.seed(bootstrap_seed)

        for _ in range(n_iter):
            idx_train = np.random.choice(n, n, replace=True)
            oob_mask = np.ones(n, dtype=bool)
            for i in idx_train:
                oob_mask[i] = False

            if oob_mask.sum() < 10:
                continue
            if y_ev[oob_mask].sum() < 2:
                continue

            try:
                auc_val = cumulative_dynamic_auc(
                    y_surv_local[idx_train],
                    y_surv_local[oob_mask],
                    risk[oob_mask],
                    [t]
                )
                val = float(auc_val[0][0]) if isinstance(auc_val, tuple) else float(auc_val[0])
                if 0.01 < val < 0.99:
                    boot_aucs.append(val)
            except:
                continue

        if len(boot_aucs) >= 50:
            boot_aucs = np.array(boot_aucs)
            mean_auc = float(boot_aucs.mean())
            ci_low = float(np.percentile(boot_aucs, 2.5))
            ci_high = float(np.percentile(boot_aucs, 97.5))
            # SURV-008: CI-based significance (no z-test)
            significant = ci_low > 0.5
            results[t] = {
                'auc': mean_auc,
                'ci_low': ci_low,
                'ci_high': ci_high,
                'p_value': 0.05 if not significant else None,
                'risk_set': int(risk_set),
                'events': int(events_at_t),
                'unstable': False
            }
        else:
            try:
                auc_val = cumulative_dynamic_auc(y_surv_local, y_surv_local, risk, [t])
                val = float(auc_val[0][0]) if isinstance(auc_val, tuple) else float(auc_val[0])
                results[t] = {'auc': val, 'ci_low': val, 'ci_high': val, 'p_value': None, 'risk_set': int(risk_set), 'events': int(events_at_t), 'unstable': True}
            except:
                continue

    return results

# ========== ANALYSIS ==========
