def get_label(col_name, value):
    """Get user-defined label for a value, or return formatted value"""
    if col_name in var_labels:
        val_labels = var_labels[col_name].get('value_labels', {})
        # Try "X.X" format
        key_float = f"{float(value):.1f}"
        if key_float in val_labels:
            return val_labels[key_float]
        # Try "X" format
        key_int = str(int(float(value)))
        if key_int in val_labels:
            return val_labels[key_int]
        # Try raw string
        key_str = str(value)
        if key_str in val_labels:
            return val_labels[key_str]
    # Clean number
    try:
        f = float(value)
        if f == int(f):
            return str(int(f))
    except:
        pass
    return str(value)

