var_labels = {}
try:
    project_path = Path("{{ project_path }}") if "{{ project_path }}" else Path(".")
    labels_path = project_path / "state" / "variable_labels.json"
    if labels_path.exists():
        with open(labels_path, 'r', encoding='utf-8') as f:
            var_labels = json.load(f)
except:
