print("## Numeric Comparison\n")

value_col = "{{ value }}"
group_col = "{{ group }}"

if value_col not in df.columns:
    raise ValueError(f"Column '{value_col}' not found")
if group_col not in df.columns:
    raise ValueError(f"Column '{group_col}' not found")

print(f"**Value variable:** `{value_col}`")
print(f"**Group variable:** `{group_col}`\n")

groups = df[group_col].dropna().unique()
n_groups = len(groups)

print(f"**Number of groups:** {n_groups}\n")

data_by_group = {}
for g in groups:
    vals = df[df[group_col] == g][value_col].dropna()
    data_by_group[g] = vals

print("### Descriptive Statistics\n")
stats_data = []
for g, vals in data_by_group.items():
    q1 = vals.quantile(0.25)
    q3 = vals.quantile(0.75)
    stats_data.append({
        'Group': str(g),
        'N': len(vals),
        'Median': vals.median(),
        'Q1': q1,
        'Q3': q3,
        'IQR': q3 - q1
    })

print("| Group | N | Median | Q1 | Q3 | IQR |")
print("|-------|---|--------|----|----|-----|")
for row in stats_data:
    print(f"| {row['Group']} | {int(row['N'])} | {row['Median']:.2f} | {row['Q1']:.2f} | {row['Q3']:.2f} | {row['IQR']:.2f} |")
print()

print("### Normality Tests\n")
# Кэшируем Shapiro-Wilk результаты
shapiro_results = {}
for g, vals in data_by_group.items():
    if len(vals) >= 3:
        stat, p = stats.shapiro(vals)
        shapiro_results[g] = (stat, p)
        sig = "***" if p < 0.001 else "**" if p < 0.01 else "*" if p < 0.05 else ""
        print(f"**{str(g)}:** Shapiro-Wilk W = {stat:.4f}, p = {fmt_p(p)} {sig}")
print()

all_normal = all(
    len(v) >= 3 and shapiro_results[g][1] >= 0.05
    for g, v in data_by_group.items() if g in shapiro_results
)

all_values = df[value_col].dropna()
n_total = len(all_values)

if all_normal:
    print("**Normality assumption:** No significant deviation from normality detected (p >= 0.05)")
else:
    print("**Normality assumption:** Not satisfied for one or more groups")
print()

print("### Homogeneity of Variances\n")
group_arrays = [v.values for v in data_by_group.values()]
try:
    levene_stat, levene_p = stats.levene(*group_arrays)
    bartlett_stat, bartlett_p = stats.bartlett(*group_arrays)
except ValueError:
    levene_stat, levene_p = 0.0, 1.0
    bartlett_stat, bartlett_p = 0.0, 1.0

sig_levene = "***" if levene_p < 0.001 else "**" if levene_p < 0.01 else "*" if levene_p < 0.05 else ""
sig_bartlett = "***" if bartlett_p < 0.001 else "**" if bartlett_p < 0.01 else "*" if bartlett_p < 0.05 else ""

print(f"**Levene's test:** W = {levene_stat:.4f}, p = {fmt_p(levene_p)} {sig_levene}")
print(f"**Bartlett's test:** statistic = {bartlett_stat:.4f}, p = {fmt_p(bartlett_p)} {sig_bartlett}")

equal_var = levene_p >= 0.05
if equal_var:
    print("**Equal variances assumed**")
else:
    print("**Unequal variances (Welch correction recommended)**")
print()

if all_normal and equal_var:
    print("### Statistical Tests\n")
    if n_groups == 2:
        g1, g2 = list(data_by_group.keys())
        t_stat, t_p = stats.ttest_ind(data_by_group[g1], data_by_group[g2])
        sig = "***" if t_p < 0.001 else "**" if t_p < 0.01 else "*" if t_p < 0.05 else ""
        print(f"**Independent t-test:** t = {t_stat:.4f}, **p = {fmt_p(t_p)}** {sig}")
        
        mean_diff = data_by_group[g1].mean() - data_by_group[g2].mean()
        print(f"**Mean difference ({g1} - {g2}):** {mean_diff:.4f}")
        
        pooled_std = np.sqrt(
            ((len(data_by_group[g1]) - 1) * data_by_group[g1].std()**2 + 
             (len(data_by_group[g2]) - 1) * data_by_group[g2].std()**2) /
            (len(data_by_group[g1]) + len(data_by_group[g2]) - 2)
        )
        cohens_d = mean_diff / pooled_std
        print(f"**Cohen's d:** {cohens_d:.4f}")
        
    else:
        f_stat, f_p = stats.f_oneway(*[v.values for v in data_by_group.values()])
        sig = "***" if f_p < 0.001 else "**" if f_p < 0.01 else "*" if f_p < 0.05 else ""
        print(f"**One-way ANOVA:** F = {f_stat:.4f}, **p = {fmt_p(f_p)}** {sig}")
        
        df_between = n_groups - 1
        df_error = n_total - n_groups
        eta_sq = f_stat * df_between / (f_stat * df_between + df_error)
        print(f"**Effect size (eta-squared):** {eta_sq:.4f}")
        
        # Post-hoc: Tukey HSD
        if f_p < 0.05 and n_groups > 2:
            try:
                from statsmodels.stats.multicomp import pairwise_tukeyhsd
                tukey = pairwise_tukeyhsd(df[value_col].dropna(), df[group_col].dropna(), alpha=0.05)
                print("\n**Post-hoc (Tukey HSD):**")
                print("| Pair | Mean Diff | p-value | Significant |")
                print("|------|-----------|---------|-------------|")
                sorted_groups = sorted(data_by_group.keys(), key=str)
                for pair_idx, (g1, g2) in enumerate(combinations(sorted_groups, 2)):
                    meandiff = tukey.meandiffs[pair_idx]
                    p_adj = tukey.pvalues[pair_idx]
                    reject = tukey.reject[pair_idx]
                    print(f"| {g1} vs {g2} | {meandiff:.3f} | {fmt_p(p_adj)} | {'✓' if reject else '-'} |")
                print()
            except:
                pass
    
else:
    print("### Non-parametric Tests\n")
    if n_groups == 2:
        g1, g2 = list(data_by_group.keys())
        u_stat, u_p = stats.mannwhitneyu(data_by_group[g1], data_by_group[g2], alternative='two-sided')
        sig = "***" if u_p < 0.001 else "**" if u_p < 0.01 else "*" if u_p < 0.05 else ""
        print(f"**Mann-Whitney U test:** U = {u_stat:.1f}, **p = {fmt_p(u_p)}** {sig}")
    else:
        h_stat, h_p = stats.kruskal(*[v.values for v in data_by_group.values()])
        sig = "***" if h_p < 0.001 else "**" if h_p < 0.01 else "*" if h_p < 0.05 else ""
        print(f"**Kruskal-Wallis H test:** H = {h_stat:.4f}, **p = {fmt_p(h_p)}** {sig}")
        
        # Post-hoc: pairwise Mann-Whitney with Bonferroni
        if h_p < 0.05 and n_groups > 2:
            try:
                sorted_groups = sorted(data_by_group.keys(), key=str)
                pairs = list(combinations(sorted_groups, 2))
                n_pairs = len(pairs)
                print("\n**Post-hoc (Mann-Whitney + Bonferroni):**")
                print("| Pair | U | p-value | Adj. p (Bonf) | Significant |")
                print("|------|---|---------|----------------|-------------|")
                for g1, g2 in pairs:
                    u_stat_pw, u_p_pw = stats.mannwhitneyu(data_by_group[g1], data_by_group[g2], alternative='two-sided')
                    p_adj = min(u_p_pw * n_pairs, 1.0)
                    sig_pw = "✓" if p_adj < 0.05 else "-"
                    print(f"| {g1} vs {g2} | {u_stat_pw:.1f} | {fmt_p(u_p_pw)} | {fmt_p(p_adj)} | {sig_pw} |")
                print()
            except:
                pass

