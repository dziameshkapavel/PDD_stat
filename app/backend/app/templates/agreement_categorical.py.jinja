def interpret_kappa(k):
    if k < 0: return "Poor (worse than chance)"
    if k < 0.20: return "Slight"
    if k < 0.40: return "Fair"
    if k < 0.60: return "Moderate"
    if k < 0.80: return "Substantial"
    return "Almost perfect"

# ========== COHEN'S KAPPA (2 raters) ==========
if len(valid_raters) == 2:
    from sklearn.metrics import cohen_kappa_score, confusion_matrix

    r1 = df_agr[valid_raters[0]].astype(str).values
    r2 = df_agr[valid_raters[1]].astype(str).values

    all_cats = sorted(set(list(r1) + list(r2)))

    print("### Cross-tabulation\n")
    ct = confusion_matrix(r1, r2, labels=all_cats)
    ct_df = pd.DataFrame(ct, index=all_cats, columns=all_cats)
    ct_df.index.name = valid_raters[0]
    ct_df.columns.name = valid_raters[1]
    print(ct_df.to_markdown())
    print()

    percent_agreement = np.trace(ct) / np.sum(ct)
    print(f"**Percent agreement:** {percent_agreement*100:.1f}%\n")

    if scale_type == 'ordinal':
        print(f"### Weighted Kappa ({weight_type} weights)\n")

        if weight_type == 'linear':
            weights = np.zeros((len(all_cats), len(all_cats)))
            for i in range(len(all_cats)):
                for j in range(len(all_cats)):
                    max_diff = len(all_cats) - 1
                    weights[i, j] = 1 - abs(i - j) / max_diff if max_diff > 0 else 1
        else:
            weights = np.zeros((len(all_cats), len(all_cats)))
            for i in range(len(all_cats)):
                for j in range(len(all_cats)):
                    max_diff = len(all_cats) - 1
                    weights[i, j] = 1 - ((i - j) / max_diff)**2 if max_diff > 0 else 1

        observed = ct / np.sum(ct)
        expected = np.outer(np.sum(observed, axis=1), np.sum(observed, axis=0))
        weighted_observed = np.sum(weights * observed)
        weighted_expected = np.sum(weights * expected)
        kappa = (weighted_observed - weighted_expected) / (1 - weighted_expected) if (1 - weighted_expected) != 0 else 0

        n = np.sum(ct)
        se = np.sqrt((weighted_observed * (1 - weighted_observed)) / (n * (1 - weighted_expected)**2)) if n > 0 and (1 - weighted_expected) > 0 else 0
        ci_low = max(-1, kappa - 1.96 * se)
        ci_high = min(1, kappa + 1.96 * se)
        z = kappa / se if se > 0 else 0
        p_val = 2 * (1 - norm.cdf(abs(z)))

    else:
        print("### Cohen's Kappa\n")
        kappa = cohen_kappa_score(r1, r2)
        n = len(r1)
        p_o = percent_agreement
        p_e = sum((np.sum(ct, axis=1)[i] / n) * (np.sum(ct, axis=0)[i] / n) for i in range(len(all_cats)))
        se = np.sqrt(p_o * (1 - p_o) / (n * (1 - p_e)**2)) if n > 0 and p_e < 1 else 0
        ci_low = max(-1, kappa - 1.96 * se)
        ci_high = min(1, kappa + 1.96 * se)
        z = kappa / se if se > 0 else 0
        p_val = 2 * (1 - norm.cdf(abs(z)))

    interpretation = interpret_kappa(kappa)

    print(f"κ = {kappa:.4f}")
    print(f"95% CI: {ci_low:.4f} – {ci_high:.4f}")
    print(f"z = {z:.2f}, p = {fmt_p(p_val)}")
    print(f"**Interpretation:** {interpretation}\n")

# ========== FLEISS' KAPPA (3+ raters) ==========
else:
    print("### Fleiss' Kappa\n")

    all_cats = sorted(set(df_agr.values.flatten().astype(str)))
    n_cats = len(all_cats)

    ratings_matrix = np.zeros((n_subjects, n_cats))
    for i in range(n_subjects):
        for j in range(len(valid_raters)):
            val = str(df_agr.iloc[i, j])
            cat_idx = all_cats.index(val) if val in all_cats else -1
            if cat_idx >= 0:
                ratings_matrix[i, cat_idx] += 1

    n_raters = len(valid_raters)

    p_j = np.sum(ratings_matrix, axis=0) / (n_subjects * n_raters)
    P_i = (np.sum(ratings_matrix**2, axis=1) - n_raters) / (n_raters * (n_raters - 1))
    P_bar = np.mean(P_i)
    P_e_bar = np.sum(p_j**2)

    kappa = (P_bar - P_e_bar) / (1 - P_e_bar) if (1 - P_e_bar) != 0 else 0

    # Standard error for Fleiss' Kappa
    term = P_e_bar - (2*n_raters - 3)*P_e_bar**2 + 2*(n_raters - 2)*np.sum(p_j**3)
    term = max(term, 1e-10)
    se = np.sqrt(2 / (n_subjects * n_raters * (n_raters - 1)) * term / (1 - P_e_bar)**2) if n_subjects > 0 and (1 - P_e_bar) > 0 else 0
    se = min(se, 0.5)
    ci_low = max(-1, kappa - 1.96 * se)
    ci_high = min(1, kappa + 1.96 * se)
    z = kappa / se if se > 0 else 0
    p_val = 2 * (1 - norm.cdf(abs(z)))

    interpretation = interpret_kappa(kappa)

    print(f"κ = {kappa:.4f}")
    print(f"95% CI: {ci_low:.4f} – {ci_high:.4f}")
    print(f"z = {z:.2f}, p = {fmt_p(p_val)}")
    print(f"**Interpretation:** {interpretation}")
    print(f"\n**Average pairwise agreement:** {P_bar*100:.1f}%\n")

    print("### Per-Category Kappa\n")
    print("| Category | κ |")
    print("|----------|----|")
    for idx, cat in enumerate(all_cats):
        p_cat = np.sum(ratings_matrix[:, idx]) / (n_subjects * n_raters)
        k_cat = (p_cat - p_cat**2) / (1 - p_cat**2) if p_cat < 1 else 1
        print(f"| {cat} | {k_cat:.4f} |")
    print()

