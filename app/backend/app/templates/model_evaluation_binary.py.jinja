# ========== DCA CURVES & TABLE ==========
if run_dca:
    print("### Decision Curve Analysis (DCA)\n")

    thresholds = np.linspace(0.01, 0.99, 99)
    key_thresholds = [0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.40, 0.50]

    for pred_col in valid_preds:
        y_pred = df_eval[pred_col].values

        print(f"**{pred_col}:**\n")
        print("| Threshold | Model NB | Treat All NB | Treat None NB | Net Benefit Gain |")
        print("|-----------|----------|-------------|---------------|------------------|")

        for t in key_thresholds:
            nb_model = net_benefit(y_true, y_pred, t)
            nb_all = net_benefit(y_true, np.ones(len(y_true)), t)
            nb_none = 0
            nb_gain = nb_model - nb_all

            print(f"| {t*100:.0f}% | {nb_model:.4f} | {nb_all:.4f} | {nb_none:.4f} | {nb_gain:+.4f} |")

        print()

    # DCA Plot
    fig, ax = plt.subplots(figsize=(10, 6))
    colors = plt.cm.tab10(np.linspace(0, 1, len(valid_preds) + 2))

    treat_all = [net_benefit(y_true, np.ones(len(y_true)), t) for t in thresholds]
    ax.plot(thresholds, treat_all, color=colors[0], lw=2, label='Treat All')
    ax.plot(thresholds, [0]*len(thresholds), color=colors[1], lw=2, label='Treat None')

    for i, pred_col in enumerate(valid_preds):
        y_pred = df_eval[pred_col].values
        nb_model = [net_benefit(y_true, y_pred, t) for t in thresholds]
        ax.plot(thresholds, nb_model, color=colors[i+2], lw=2, label=pred_col)

    ax.set_xlabel('Threshold Probability', fontsize=12)
    ax.set_ylabel('Net Benefit', fontsize=12)
    ax.set_xlim(0, 1)

    all_nbs = [max([net_benefit(y_true, df_eval[p].values, t) for t in thresholds]) for p in valid_preds]
    max_nb = max([max(treat_all)] + all_nbs)
    ax.set_ylim(-0.05, max_nb + 0.05)

    ax.legend(loc='upper right', fontsize=9)
    ax.grid(True, alpha=0.3)
    ax.spines['top'].set_visible(False)
    ax.spines['right'].set_visible(False)

    plt.tight_layout()
    dca_ts = str(int(time.time()))
    dca_plot = f"binary_eval_dca_{dca_ts}"
    save_plot(dca_plot, fig)
    print(f"![DCA Curves](/plots/{dca_plot}.png)\n")

