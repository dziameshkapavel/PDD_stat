# ========== METRIC FUNCTIONS ==========
def is_inverted(y_true, y_pred):
    return roc_auc_score(y_true, y_pred) < 0.5

def fix_if_inverted(y_true, y_pred):
    if auto_invert and is_inverted(y_true, y_pred):
        return 1 - y_pred
    return y_pred

def calc_auc(y_true, y_pred):
    if auto_invert:
        yp = fix_if_inverted(y_true, y_pred)
    else:
        yp = y_pred
    return roc_auc_score(y_true, yp)

def calc_accuracy(y_true, y_pred):
    yp = fix_if_inverted(y_true, y_pred)
    return accuracy_score(y_true, (yp >= 0.5).astype(int))

def _cm_vals(y_true, y_pred):
    y_pred_bin = (y_pred >= 0.5).astype(int)
    cm = confusion_matrix(y_true, y_pred_bin)
    if cm.size == 4:
        tn, fp, fn, tp = cm.ravel()
    elif cm.size == 1:
        val = cm.ravel()[0]
        if val == 0:
            tn, fp, fn, tp = len(y_true), 0, 0, 0
        else:
            tn, fp, fn, tp = 0, 0, 0, len(y_true)
    else:
        tn, fp, fn, tp = 0, 0, 0, 0
    return tn, fp, fn, tp

def calc_sensitivity(y_true, y_pred):
    tn, fp, fn, tp = _cm_vals(y_true, y_pred)
    return tp / (tp + fn) if (tp + fn) > 0 else 0

def calc_specificity(y_true, y_pred):
    tn, fp, fn, tp = _cm_vals(y_true, y_pred)
    return tn / (tn + fp) if (tn + fp) > 0 else 0

def calc_ppv(y_true, y_pred):
    tn, fp, fn, tp = _cm_vals(y_true, y_pred)
    return tp / (tp + fp) if (tp + fp) > 0 else 0

def calc_npv(y_true, y_pred):
    tn, fp, fn, tp = _cm_vals(y_true, y_pred)
    return tn / (tn + fn) if (tn + fn) > 0 else 0

def calc_f1(y_true, y_pred):
    yp = fix_if_inverted(y_true, y_pred)
    y_pred_bin = (yp >= 0.5).astype(int)
    return f1_score(y_true, y_pred_bin, zero_division=0)

def calc_brier(y_true, y_pred):
    yp = fix_if_inverted(y_true, y_pred)
    return brier_score_loss(y_true, yp)

def bootstrap_ci(y_true, y_pred, metric_func, n_iter=1000):
    n = len(y_true)
    values = []
    np.random.seed(bootstrap_seed)

    for _ in range(n_iter):
        idx = np.random.choice(n, n, replace=True)
        y_t = y_true[idx]
        y_p = y_pred[idx]

        if len(np.unique(y_t)) < 2:
            continue
        try:
            values.append(metric_func(y_t, y_p))
        except:
            continue

    if not values:
        return None, None, None

    base = metric_func(y_true, y_pred)
    ci_low = np.percentile(values, 2.5)
    ci_high = np.percentile(values, 97.5)
    return base, ci_low, ci_high

def net_benefit(y_true, y_pred, threshold):
    if threshold <= 0 or threshold >= 1:
        return 0
    yp = fix_if_inverted(y_true, y_pred)
    y_pred_bin = (yp >= threshold).astype(int)
    tp = ((y_pred_bin == 1) & (y_true == 1)).sum()
    fp = ((y_pred_bin == 1) & (y_true == 0)).sum()
    n = len(y_true)
    return (tp / n) - (fp / n) * (threshold / (1 - threshold))

