    print(f"**Best C (inverse of λ):** {best_C:.4f} (selected by 5-fold CV)\n")
    # LAS-102: 1-SE rule
    cv_means = grid.cv_results_['mean_test_score']
    cv_stds = grid.cv_results_['std_test_score']
    best_idx = np.argmax(cv_means)
    best_score = cv_means[best_idx]
    one_se_threshold = best_score - cv_stds[best_idx]
    valid_indices = [i for i in range(best_idx + 1) if cv_means[i] >= one_se_threshold]
    if valid_indices:
        one_se_idx = valid_indices[0]
        c_1se = grid.param_grid['C'][one_se_idx]
    else:
        c_1se = best_C
