def prepare_dummies(df_in, covariates_list, ref_groups, cov_types):
    df_out = df_in.copy()
    encoding_map = {}
    dummy_to_info = {}
    encoded_covariates = []
    
    for col in covariates_list:
        if col in cov_types:
            is_cat = (cov_types[col] == 'categorical')
        else:
            is_cat = (df_out[col].dtype == 'object' or
                      df_out[col].dtype.name == 'category' or
                      isinstance(df_out[col].dtype, pd.CategoricalDtype))
        
        if is_cat:
            df_out[col] = df_out[col].astype(str).fillna('__MISSING__')
            categories = sorted(list(df_out[col].unique()))
            
            ref = ref_groups.get(col)
            if ref not in categories:
                ref = categories[0] if categories else '__MISSING__'
            
            encoding_map[col] = {
                'categories': categories,
                'reference': ref,
                'dummy_cols': []
            }
            
            for cat in categories:
                if cat == ref:
                    continue
                dummy_name = f"{col}_{cat}"
                df_out[dummy_name] = (df_out[col] == cat).astype(int)
                encoding_map[col]['dummy_cols'].append(dummy_name)
                encoded_covariates.append(dummy_name)
                dummy_to_info[dummy_name] = {
                    'original': col,
                    'category': cat,
                    'reference': ref
                }
        else:
            df_out[col] = pd.to_numeric(df_out[col], errors='coerce')
            encoded_covariates.append(col)
            
    return df_out, encoded_covariates, encoding_map, dummy_to_info

