def evaluate_final(pred_list):
    expanded = get_expanded(pred_list)
    if validation_strategy == "split":
        col_idx = [encoded_covs.index(e) for e in expanded]
        Xf_train = X_train[:, col_idx]
        Xf_test = X_test[:, col_idx]
        scaler = StandardScaler()
        Xf_train_scaled = scaler.fit_transform(Xf_train)
        Xf_test_scaled = scaler.transform(Xf_test)
        model = LogisticRegression(max_iter=1000, random_state=42, class_weight='balanced')
        model.fit(Xf_train_scaled, y_train)
        y_pred = model.predict(Xf_test_scaled)
        y_proba = model.predict_proba(Xf_test_scaled)[:, 1]
        y_true = y_test
        fpr, tpr, _ = roc_curve(y_true, y_proba)
        roc_auc = auc(fpr, tpr)
        tn, fp, fn, tp = confusion_matrix(y_true, y_pred).ravel()
        metrics = {
            "auc": roc_auc,
            "accuracy": (tp + tn) / (tp + tn + fp + fn) if (tp + tn + fp + fn) > 0 else 0,
            "sensitivity": tp / (tp + fn) if (tp + fn) > 0 else 0,
            "specificity": tn / (tn + fp) if (tn + fp) > 0 else 0
        }
        return model, metrics, fpr, tpr, y_true, y_proba
    elif validation_strategy == "cv":
        col_idx = [encoded_covs.index(e) for e in expanded]
        Xf = X_all[:, col_idx]
        scaler = StandardScaler()
        Xf_scaled = scaler.fit_transform(Xf)
        model = LogisticRegression(max_iter=1000, random_state=42, class_weight='balanced')
        cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
        y_proba_2d = cross_val_predict(model, Xf_scaled, y_all, cv=cv, method='predict_proba')
        y_proba = y_proba_2d[:, 1] if y_proba_2d.ndim == 2 and y_proba_2d.shape[1] == 2 else y_proba_2d
        y_pred = cross_val_predict(model, Xf_scaled, y_all, cv=cv, method='predict')
        y_true = y_all
        fpr, tpr, _ = roc_curve(y_true, y_proba)
        roc_auc = roc_auc_score(y_true, y_proba)
        tn, fp, fn, tp = confusion_matrix(y_true, y_pred).ravel()
        metrics = {
            "auc": roc_auc,
            "accuracy": (tp + tn) / (tp + tn + fp + fn) if (tp + tn + fp + fn) > 0 else 0,
            "sensitivity": tp / (tp + fn) if (tp + fn) > 0 else 0,
            "specificity": tn / (tn + fp) if (tn + fp) > 0 else 0
        }
        model.fit(Xf_scaled, y_all)  # final fit for coefficients
        return model, metrics, fpr, tpr, y_true, y_proba
    else:  # none
        model, X, y, _ = fit_logistic(pred_list)
        metrics = calculate_metrics(model, X, y)
        y_proba = model.predict_proba(X)[:, 1]
        fpr, tpr, _ = roc_curve(y, y_proba)
        return model, metrics, fpr, tpr, y, y_proba

def calculate_vif(col_list):
    if len(col_list) < 2:
        return {}
    try:
        from statsmodels.stats.outliers_influence import variance_inflation_factor
        X = df_log[col_list].dropna()
        if X.shape[0] < 10 or X.shape[1] < 2:
            return {}
        vif_data = {}
        for i, col in enumerate(X.columns):
            try:
                vif = float(variance_inflation_factor(X.values, i))
                if np.isnan(vif) or np.isinf(vif):
                    vif = 999.0
                vif_data[str(col)] = {
                    "value": vif,
                    "high": bool(vif > 10),
                    "moderate": bool(vif > 5 and vif <= 10)
                }
            except:
                vif_data[str(col)] = {"value": 0.0, "high": False, "moderate": False}
        return vif_data
    except Exception as e:
        output_metrics["warnings"].append(f"VIF error: {str(e)}")
        return {}

def calculate_metrics(model, X, y):
    if model is None:
        return {}
    y_pred = model.predict(X)
    y_proba = model.predict_proba(X)[:, 1]
    fpr, tpr, _ = roc_curve(y, y_proba)
    auc_score = auc(fpr, tpr)
    tn, fp, fn, tp = confusion_matrix(y, y_pred).ravel()
    accuracy = (tp + tn) / (tp + tn + fp + fn)
    sensitivity = tp / (tp + fn) if (tp + fn) > 0 else 0
    specificity = tn / (tn + fp) if (tn + fp) > 0 else 0
    return {
        "auc": auc_score,
        "accuracy": accuracy,
        "sensitivity": sensitivity,
        "specificity": specificity
    }

def hosmer_lemeshow_test(model, X, y, n_groups=10):
    try:
        y_proba = model.predict_proba(X)[:, 1]
        sorted_idx = np.argsort(y_proba)
        sorted_y = y[sorted_idx]
        sorted_proba = y_proba[sorted_idx]
        group_size = len(y) // n_groups
        observed, expected = [], []
        for i in range(n_groups):
            start = i * group_size
            end = (i + 1) * group_size if i < n_groups - 1 else len(y)
            group_y = sorted_y[start:end]
            group_proba = sorted_proba[start:end]
            observed.append(group_y.sum())
            expected.append(group_proba.sum())
        chi_square = 0
        for i in range(n_groups):
            start = i * group_size
            end = (i + 1) * group_size if i < n_groups - 1 else len(y)
            n_g = end - start
            obs = observed[i]
            exp = expected[i]
            if exp > 0 and exp < n_g:
                chi_square += (obs - exp)**2 / (exp * (1 - exp/n_g))
        from scipy.stats import chi2
        p_value = 1 - chi2.cdf(chi_square, n_groups - 2)
        return {
            "chi_square": float(chi_square),
            "p_value": float(p_value),
            "df": n_groups - 2,
            "significant": bool(p_value < 0.05)
        }
    except Exception as e:
        return {"error": str(e)}

def get_model_summary(model, pred_list, X_scaled=None):
    if model is None:
        return []
    coefs = model.coef_[0]
    intercept = model.intercept_[0]
    if X_scaled is None:
        X = df_log[pred_list].values
        X_scaled = StandardScaler().fit_transform(X)
    X_with_intercept = np.column_stack([np.ones(X_scaled.shape[0]), X_scaled])
    try:
        y_proba = model.predict_proba(X_scaled)[:, 1]
        W = np.diag(y_proba * (1 - y_proba))
        cov_matrix = np.linalg.inv(X_with_intercept.T @ W @ X_with_intercept)
        se = np.sqrt(np.diag(cov_matrix))
        all_coefs = np.concatenate([[intercept], coefs])
        z_scores = all_coefs / se
        from scipy import stats
        p_values = 2 * (1 - stats.norm.cdf(np.abs(z_scores)))
    except:
        from scipy import stats
        se = np.ones(len(coefs) + 1)
        p_values = np.ones(len(coefs) + 1)
    
    summary = []
    summary.append({
        "variable": "Intercept",
        "coef": float(intercept),
        "or": None,
        "ci_lower": None,
        "ci_upper": None,
        "p_value": float(p_values[0]) if len(p_values) > 0 else 1.0
    })
    for i, pred in enumerate(pred_list):
        coef = coefs[i]
        odds_ratio = np.exp(coef)
        ci_lower = np.exp(coef - 1.96 * se[i+1]) if i+1 < len(se) else None
        ci_upper = np.exp(coef + 1.96 * se[i+1]) if i+1 < len(se) else None
        summary.append({
            "variable": pred,
            "coef": float(coef),
            "or": float(odds_ratio),
            "ci_lower": float(ci_lower) if ci_lower else None,
            "ci_upper": float(ci_upper) if ci_upper else None,
            "p_value": float(p_values[i+1]) if i+1 < len(p_values) else 1.0
        })
    return summary

def print_summary_table(summary):
    print("| Variable | β (coef) | OR | 95% CI | p-value |")
    print("|----------|----------|-----|--------|---------|")
    for row in summary:
        var = display_name(row['variable'])
