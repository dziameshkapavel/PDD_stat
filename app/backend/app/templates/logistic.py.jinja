            roc_auc = roc_auc_score(y_all, y_proba)
            dca_data.append((pred, y_all, y_proba))
            print(f"**Predictor:** `{pred}`\n")
            print(f"\n**AUC (5-fold CV):** {roc_auc:.4f}  \n---\n")
        else:
            model, X, y, _ = fit_logistic([pred])
            if model is None:
                print(f"**{pred}:** Failed\n")
                continue
            print(f"**Predictor:** `{pred}`\n")
            summary = get_model_summary(model, expanded, X)
            print_summary_table(summary)
            metrics = calculate_metrics(model, X, y)
            print(f"\n**AUC:** {metrics['auc']:.4f}  \n---\n")
            y_proba = model.predict_proba(X)[:, 1]
            fpr, tpr, _ = roc_curve(y, y_proba)
            roc_auc = auc(fpr, tpr)
            dca_data.append((pred, y, y_proba))
        
        roc_data.append((pred, fpr, tpr, roc_auc))
    
    # Один график ROC со всеми кривыми
    if roc_data:
        timestamp = str(int(time.time()))
        fig, ax = plt.subplots(1, 1, figsize=(10, 8))
        
        colors = plt.cm.tab10(np.linspace(0, 1, len(roc_data)))
        
        for i, (pred, fpr, tpr, roc_auc) in enumerate(roc_data):
            ax.plot(fpr, tpr, color=colors[i], lw=2, label=f'{pred} (AUC = {roc_auc:.3f})')
        
        ax.plot([0, 1], [0, 1], color='navy', lw=2, linestyle='--', alpha=0.5)
        ax.set_xlim([0.0, 1.0])
        ax.set_ylim([0.0, 1.05])
        ax.set_xlabel('False Positive Rate')
        ax.set_ylabel('True Positive Rate')
        ax.set_title('ROC Curves - Univariate Analysis')
        ax.legend(loc="lower right", fontsize=9)
        ax.grid(True, alpha=0.3)
        
        plt.tight_layout()
        plot_filename = f"logistic_uni_{timestamp}"
        save_plot(plot_filename, fig)
        output_metrics["plots"] = [f"{plot_filename}.png"]
        print(f"\n![Logistic Univariate](/plots/{plot_filename}.png)\n")

        if dca_data:
            names = [d[0] for d in dca_data]
            probas = [d[2] for d in dca_data]
            yt = dca_data[0][1]
            plot_dca(yt, probas, names, "logistic_uni", timestamp)
            plot_calibration(yt, probas, names, "logistic_uni", timestamp)

# ==================== MULTIVARIATE ====================
elif regression_type in ["multi", "enter"]:
    print("### Multivariate Model\n")
    
    expanded = get_expanded(valid_pred)
    
    if validation_strategy == "split":
        col_idx = [encoded_covs.index(e) for e in expanded]
        Xm_train = X_train[:, col_idx]
        Xm_test = X_test[:, col_idx]
        scaler = StandardScaler()
        Xm_train_scaled = scaler.fit_transform(Xm_train)
        Xm_test_scaled = scaler.transform(Xm_test)
        model = LogisticRegression(max_iter=1000, random_state=42, class_weight='balanced')
        model.fit(Xm_train_scaled, y_train)
        
        y_pred = model.predict(Xm_test_scaled)
        y_proba = model.predict_proba(Xm_test_scaled)[:, 1]
        fpr, tpr, _ = roc_curve(y_test, y_proba)
        roc_auc = auc(fpr, tpr)
        tn, fp, fn, tp = confusion_matrix(y_test, y_pred).ravel()
        accuracy = (tp + tn) / (tp + tn + fp + fn)
        sensitivity = tp / (tp + fn) if (tp + fn) > 0 else 0
        specificity = tn / (tn + fp) if (tn + fp) > 0 else 0
        metrics = {"auc": roc_auc, "accuracy": accuracy, "sensitivity": sensitivity, "specificity": specificity}
        output_metrics.update(metrics)
        output_metrics["vif"] = calculate_vif(expanded)
        output_metrics["hosmer_lemeshow"] = hosmer_lemeshow_test(model, Xm_train_scaled, y_train)
        output_metrics["equation_html"] = build_equation(model, valid_pred)
        
        summary = get_model_summary(model, expanded, Xm_train_scaled)
        print_summary_table(summary)
        print(f"\n**AUC (test):** {output_metrics['auc']:.4f}")
        print(f"**Accuracy (test):** {output_metrics['accuracy']:.4f}")
        print(f"**Sensitivity (test):** {output_metrics['sensitivity']:.4f}")
        print(f"**Specificity (test):** {output_metrics['specificity']:.4f}")
    
    elif validation_strategy == "cv":
        col_idx = [encoded_covs.index(e) for e in expanded]
        Xm = X_all[:, col_idx]
        scaler = StandardScaler()
        Xm_scaled = scaler.fit_transform(Xm)
        model = LogisticRegression(max_iter=1000, random_state=42, class_weight='balanced')
        cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
        y_proba_2d = cross_val_predict(model, Xm_scaled, y_all, cv=cv, method='predict_proba')
        y_proba = y_proba_2d[:, 1] if y_proba_2d.ndim == 2 and y_proba_2d.shape[1] == 2 else y_proba_2d
        y_pred = cross_val_predict(model, Xm_scaled, y_all, cv=cv, method='predict')
        fpr, tpr, _ = roc_curve(y_all, y_proba)
        roc_auc = roc_auc_score(y_all, y_proba)
        tn, fp, fn, tp = confusion_matrix(y_all, y_pred).ravel()
        accuracy = (tp + tn) / (tp + tn + fp + fn)
        sensitivity = tp / (tp + fn) if (tp + fn) > 0 else 0
        specificity = tn / (tn + fp) if (tn + fp) > 0 else 0
        metrics = {"auc": roc_auc, "accuracy": accuracy, "sensitivity": sensitivity, "specificity": specificity}
        output_metrics.update(metrics)
        output_metrics["vif"] = calculate_vif(expanded)
        # Fit final model on all data for coefficients
        model.fit(Xm_scaled, y_all)
        output_metrics["hosmer_lemeshow"] = hosmer_lemeshow_test(model, Xm_scaled, y_all)
        output_metrics["equation_html"] = build_equation(model, valid_pred)
        summary = get_model_summary(model, expanded, Xm_scaled)
        print_summary_table(summary)
        print(f"\n**AUC (5-fold CV):** {output_metrics['auc']:.4f}")
        print(f"**Accuracy (5-fold CV):** {output_metrics['accuracy']:.4f}")
        print(f"**Sensitivity (5-fold CV):** {output_metrics['sensitivity']:.4f}")
        print(f"**Specificity (5-fold CV):** {output_metrics['specificity']:.4f}")
    
    else:  # none
        model, X, y, expanded = fit_logistic(valid_pred)
        if model is None:
            raise ValueError("Model fitting failed")
        metrics = calculate_metrics(model, X, y)
        output_metrics.update(metrics)
        output_metrics["vif"] = calculate_vif(expanded)
        output_metrics["hosmer_lemeshow"] = hosmer_lemeshow_test(model, X, y)
        output_metrics["equation_html"] = build_equation(model, valid_pred)
        summary = get_model_summary(model, expanded, X)
        print_summary_table(summary)
        print("⚠️ **Metrics on training data (optimistic)**")
        print(f"\n**AUC:** {output_metrics['auc']:.4f}")
        print(f"**Accuracy:** {output_metrics['accuracy']:.4f}")
        print(f"**Sensitivity:** {output_metrics['sensitivity']:.4f}")
        print(f"**Specificity:** {output_metrics['specificity']:.4f}")
        y_proba = model.predict_proba(X)[:, 1]
        fpr, tpr, _ = roc_curve(y, y_proba)
        roc_auc = output_metrics['auc']
    
    hl = output_metrics.get('hosmer_lemeshow', {})
    if 'p_value' in hl:
        print(f"\n**Hosmer-Lemeshow:** p = {fmt_p(hl['p_value'])} {'⚠️' if hl['p_value'] < 0.05 else '✓'}")
    
    if len(valid_pred) > 1 and output_metrics.get("vif"):
        print("\n**VIF:**")
        for var, res in output_metrics["vif"].items():
            if isinstance(res, dict):
                vname = display_name(var)
                print(f"   `{vname}`: {res.get('value', 0):.2f}")
    
    # ROC
    timestamp = str(int(time.time()))
    fig, ax = plt.subplots(1, 1, figsize=(8, 8))
    ax.plot(fpr, tpr, color='darkorange', lw=2, label=f'ROC (AUC = {roc_auc:.3f})')
    ax.plot([0, 1], [0, 1], color='navy', lw=2, linestyle='--', alpha=0.5)
    ax.set_xlim([0.0, 1.0])
    ax.set_ylim([0.0, 1.05])
    ax.set_xlabel('False Positive Rate')
    ax.set_ylabel('True Positive Rate')
    ax.set_title('ROC Curve - Multivariate Model')
    ax.legend(loc="lower right")
    ax.grid(True, alpha=0.3)
    
    plt.tight_layout()
    plot_filename = f"logistic_multi_{timestamp}"
    save_plot(plot_filename, fig)
    output_metrics["plots"] = [f"{plot_filename}.png"]
    print(f"\n![Logistic Multivariate](/plots/{plot_filename}.png)\n")

    # DCA and Calibration for Multi
    if validation_strategy == "split":
        dca_y_true = y_test
    elif validation_strategy == "cv":
        dca_y_true = y_all
    else:
        dca_y_true = y
    plot_dca(dca_y_true, [y_proba], ["Model"], "logistic_multi", timestamp)
    plot_calibration(dca_y_true, [y_proba], ["Model"], "logistic_multi", timestamp)
    save_predictions_to_df(save_pred_col, valid_pred)

# ==================== FORWARD ====================
elif regression_type == "forward":
    print("### Forward Selection\n")
    
    if validation_strategy == "split":
        print("⚠️ **Note:** Stepwise selection uses all data for variable selection (max power).")
        print("   Final metrics are computed on the test set.\n")
    else:
        print("⚠️ **Note:** Stepwise selection uses p-values for variable selection.")
        print("   P-values in the final model **do not account for the selection process** and may be inflated.")
        if validation_strategy == "none":
            print("   Metrics on training data are **optimistic**. Use split or CV.")
        print("   Consider LASSO or Random Forest for more robust selection.\n")
    
    selected = []
    remaining = valid_pred.copy()
    step = 1
    
    while remaining:
        best_pval = 1.0
        best_pred = None
        
        for pred in remaining:
            test_preds = selected + [pred]
            model, X, y, expanded = fit_logistic(test_preds)
            if model is None:
                continue
            summary = get_model_summary(model, expanded, X)
            min_pval = 1.0
            for row in summary:
                v = row['variable']
                if v == pred or (v in dummy_to_info and dummy_to_info[v]['original'] == pred):
                    if row['p_value'] is not None and row['p_value'] < min_pval:
                        min_pval = row['p_value']
            if min_pval < best_pval:
                best_pval = min_pval
                best_pred = pred
        
        if best_pval < 0.05 and best_pred:
            selected.append(best_pred)
            remaining.remove(best_pred)
            output_metrics["model_steps"].append({
                "step": step, "action": "added",
                "variable": best_pred, "p_value": float(best_pval)
            })
            print(f"Step {step}: + {best_pred} (p={fmt_p(best_pval)})")
            step += 1
        else:
            break
    
    if selected:
        print(f"\n**Final model:** {', '.join(selected)}")
        model, metrics, fpr, tpr, y_true, y_proba = evaluate_final(selected)
        output_metrics.update(metrics)
        expanded = get_expanded(selected)
        output_metrics["vif"] = calculate_vif(expanded)
        output_metrics["equation_html"] = build_equation(model, selected)
        
        # H-L test: fit on all data
        hl_expanded = get_expanded(selected)
        hl_idx = [encoded_covs.index(e) for e in hl_expanded]
        X_hl = X_all[:, hl_idx]
        X_hl_scaled = StandardScaler().fit_transform(X_hl)
        hl_model = LogisticRegression(max_iter=1000, random_state=42, class_weight='balanced')
        hl_model.fit(X_hl_scaled, y_all)
        output_metrics["hosmer_lemeshow"] = hosmer_lemeshow_test(hl_model, X_hl_scaled, y_all)
        
        # Summary table from full-data model (avoids scaler inconsistency)
        summary_model, summary_X, summary_y, summary_exp = fit_logistic(selected)
        summary = get_model_summary(summary_model, summary_exp, summary_X)
        if summary:
            print_summary_table(summary)
        
        auc_val = metrics['auc']
        label_suffix = " (test)" if validation_strategy == "split" else " (5-fold CV)" if validation_strategy == "cv" else ""
        print(f"\n**AUC{label_suffix}:** {auc_val:.4f}")
        
        # ROC
        timestamp = str(int(time.time()))
        fig, ax = plt.subplots(1, 1, figsize=(8, 8))
        roc_auc = auc_val
        ax.plot(fpr, tpr, color='darkorange', lw=2, label=f'ROC (AUC = {roc_auc:.3f})')
        ax.plot([0, 1], [0, 1], color='navy', lw=2, linestyle='--', alpha=0.5)
        ax.set_xlim([0.0, 1.0])
        ax.set_ylim([0.0, 1.05])
        ax.set_xlabel('False Positive Rate')
        ax.set_ylabel('True Positive Rate')
        ax.set_title('ROC Curve - Forward Selection')
        ax.legend(loc="lower right")
        ax.grid(True, alpha=0.3)
        plt.tight_layout()
        plot_filename = f"logistic_forward_{timestamp}"
        save_plot(plot_filename, fig)
        output_metrics["plots"] = [f"{plot_filename}.png"]
        print(f"\n![Logistic Forward](/plots/{plot_filename}.png)\n")
        plot_dca(y_true, [y_proba], ["Model"], "logistic_forward", timestamp)
        plot_calibration(y_true, [y_proba], ["Model"], "logistic_forward", timestamp)
        save_predictions_to_df(save_pred_col, selected)
    else:
        output_metrics["warnings"].append("No predictors selected")

# ==================== BACKWARD ====================
elif regression_type == "backward":
    print("### Backward Elimination\n")
    
    if validation_strategy == "split":
        print("⚠️ **Note:** Backward elimination uses all data for variable removal (max power).")
        print("   Final metrics are computed on the test set.\n")
    else:
        print("⚠️ **Note:** Backward elimination uses p-values for variable removal.")
        print("   P-values in the final model **do not account for the selection process** and may be inflated.")
        if validation_strategy == "none":
            print("   Metrics on training data are **optimistic**. Use split or CV.")
        print("   Consider LASSO or Random Forest for more robust selection.\n")
    
    current = valid_pred.copy()
    step = 1
    
    while len(current) > 1:
        expanded = get_expanded(current)
        model, X, y, _ = fit_logistic(current)
        if model is None:
            break
        summary = get_model_summary(model, expanded, X)
        var_max_p = {}
        for row in summary:
            v = row['variable']
            if v == "Intercept":
                continue
            orig = dummy_to_info[v]['original'] if v in dummy_to_info else v
            p = row['p_value'] if row['p_value'] is not None else 1.0
            if orig not in var_max_p or p > var_max_p[orig]:
                var_max_p[orig] = p
        if not var_max_p:
            break
        worst_pred = max(var_max_p, key=var_max_p.get)
        max_pval = var_max_p[worst_pred]
        if max_pval > 0.1 and worst_pred:
            current.remove(worst_pred)
            output_metrics["model_steps"].append({
                "step": step, "action": "removed",
                "variable": worst_pred, "p_value": float(max_pval)
            })
            print(f"Step {step}: - {worst_pred} (p={fmt_p(max_pval)})")
            step += 1
        else:
            break
    
    if current:
        print(f"\n**Final model:** {', '.join(current)}")
        model, metrics, fpr, tpr, y_true, y_proba = evaluate_final(current)
        output_metrics.update(metrics)
        expanded = get_expanded(current)
        output_metrics["vif"] = calculate_vif(expanded)
        output_metrics["equation_html"] = build_equation(model, current)
        
        # H-L test: fit on all data
        hl_expanded = get_expanded(current)
        hl_idx = [encoded_covs.index(e) for e in hl_expanded]
        X_hl = X_all[:, hl_idx]
        X_hl_scaled = StandardScaler().fit_transform(X_hl)
        hl_model = LogisticRegression(max_iter=1000, random_state=42, class_weight='balanced')
        hl_model.fit(X_hl_scaled, y_all)
        output_metrics["hosmer_lemeshow"] = hosmer_lemeshow_test(hl_model, X_hl_scaled, y_all)
        
        # Summary table from full-data model (avoids scaler inconsistency)
        summary_model, summary_X, summary_y, summary_exp = fit_logistic(current)
        summary = get_model_summary(summary_model, summary_exp, summary_X)
        if summary:
            print_summary_table(summary)
        
        auc_val = metrics['auc']
        label_suffix = " (test)" if validation_strategy == "split" else " (5-fold CV)" if validation_strategy == "cv" else ""
        print(f"\n**AUC{label_suffix}:** {auc_val:.4f}")
        
        # ROC
        timestamp = str(int(time.time()))
        fig, ax = plt.subplots(1, 1, figsize=(8, 8))
        roc_auc = auc_val
        ax.plot(fpr, tpr, color='darkorange', lw=2, label=f'ROC (AUC = {roc_auc:.3f})')
        ax.plot([0, 1], [0, 1], color='navy', lw=2, linestyle='--', alpha=0.5)
        ax.set_xlim([0.0, 1.0])
        ax.set_ylim([0.0, 1.05])
        ax.set_xlabel('False Positive Rate')
        ax.set_ylabel('True Positive Rate')
        ax.set_title('ROC Curve - Backward Elimination')
        ax.legend(loc="lower right")
        ax.grid(True, alpha=0.3)
        plt.tight_layout()
        plot_filename = f"logistic_backward_{timestamp}"
        save_plot(plot_filename, fig)
        output_metrics["plots"] = [f"{plot_filename}.png"]
        print(f"\n![Logistic Backward](/plots/{plot_filename}.png)\n")
        plot_dca(y_true, [y_proba], ["Model"], "logistic_backward", timestamp)
        plot_calibration(y_true, [y_proba], ["Model"], "logistic_backward", timestamp)
        save_predictions_to_df(save_pred_col, current)
    else:
        output_metrics["warnings"].append("All predictors removed")

print("\n---")
print("**Logistic regression complete**")

output_metrics["n_total"] = len(df_log)
output_metrics["n_events"] = int(n_cases)
output_metrics["predictors"] = valid_pred
output_metrics["target"] = target_col
output_metrics["encoding_map"] = {col: {'categories': info['categories'], 'reference': info['reference']} for col, info in encoding_map.items()}

# Helper to build coefficient list from summary
def build_coef_list(summary_rows):
    result = []
    for row in summary_rows:
        if row['variable'] == 'Intercept':
            continue
        result.append({
            "variable": row['variable'],
            "display_name": display_name(row['variable']),
            "coef": row['coef'],
            "or": row['or'],
            "p_value": row['p_value']
        })
    return result

if regression_type in ["multi", "enter"]:
    try:
        summary_model, summary_X, summary_y, summary_exp = fit_logistic(valid_pred)
        summary = get_model_summary(summary_model, summary_exp, summary_X)
        if summary:
            output_metrics["coefficients"] = build_coef_list(summary)
            output_metrics["significant_predictors"] = [
                row['variable'] for row in summary
                if row['variable'] != 'Intercept' and row['p_value'] < 0.05
            ]
    except:
        pass

if regression_type == "forward" and 'selected' in dir() and selected:
    try:
        model, X, y, expanded = fit_logistic(selected)
        summary = get_model_summary(model, expanded, X)
        if summary:
            output_metrics["coefficients"] = build_coef_list(summary)
            output_metrics["significant_predictors"] = [
                row['variable'] for row in summary
                if row['variable'] != 'Intercept' and row['p_value'] < 0.05
            ]
    except:
        pass

if regression_type == "backward" and 'current' in dir() and current:
    try:
        model, X, y, expanded = fit_logistic(current)
        summary = get_model_summary(model, expanded, X)
        if summary:
            output_metrics["coefficients"] = build_coef_list(summary)
            output_metrics["significant_predictors"] = [
                row['variable'] for row in summary
                if row['variable'] != 'Intercept' and row['p_value'] < 0.05
            ]
    except:
        pass

if regression_type == "uni":
    try:
        univariate_results = []
        for pred in valid_pred:
            model_uni, X_uni, y_uni, _ = fit_logistic([pred])
            if model_uni is not None:
                y_proba = model_uni.predict_proba(X_uni)[:, 1]
                auc_uni = roc_auc_score(y_uni, y_proba)
                univariate_results.append({"predictor": pred, "auc": float(auc_uni)})
        output_metrics["univariate_aucs"] = univariate_results
    except:
        pass

if regression_type == "forward" and 'selected' in dir():
    output_metrics["final_predictors"] = selected
if regression_type == "backward" and 'current' in dir():
    output_metrics["final_predictors"] = current

output_metrics = make_json_serializable(output_metrics)
