def net_benefit(y_true, y_pred, threshold):
    if threshold <= 0 or threshold >= 1:
        return 0
    y_pred_bin = (y_pred >= threshold).astype(int)
    tp = ((y_pred_bin == 1) & (y_true == 1)).sum()
    fp = ((y_pred_bin == 1) & (y_true == 0)).sum()
    n = len(y_true)
    return (tp / n) - (fp / n) * (threshold / (1 - threshold))

def plot_dca(y_true, proba_list, name_list, prefix, ts):
    if not proba_list:
        return
    thresholds = np.linspace(0.01, 0.99, 99)
    key_ths = [0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.40, 0.50]
    print("### Decision Curve Analysis (DCA)\n")
    for name, yp in zip(name_list, proba_list):
        print(f"**{name}:**\n")
        print("| Threshold | Model NB | Treat All NB | Treat None NB | Net Benefit Gain |")
        print("|-----------|----------|---------------|---------------|------------------|")
        for t in key_ths:
            nb_m = net_benefit(y_true, yp, t)
            nb_a = net_benefit(y_true, np.ones(len(y_true)), t)
            print(f"| {t*100:.0f}% | {nb_m:.4f} | {nb_a:.4f} | 0.0000 | {nb_m-nb_a:+.4f} |")
        print()
    fig, ax = plt.subplots(figsize=(10, 6))
    colors = plt.cm.tab10(np.linspace(0, 1, len(proba_list)+2))
    ta = [net_benefit(y_true, np.ones(len(y_true)), t) for t in thresholds]
    ax.plot(thresholds, ta, color=colors[0], lw=2, label='Treat All')
    ax.plot(thresholds, [0]*len(thresholds), color=colors[1], lw=2, label='Treat None')
    for i, (name, yp) in enumerate(zip(name_list, proba_list)):
        nb = [net_benefit(y_true, yp, t) for t in thresholds]
        ax.plot(thresholds, nb, color=colors[i+2], lw=2, label=name)
    ax.set_xlabel('Threshold Probability', fontsize=12)
    ax.set_ylabel('Net Benefit', fontsize=12)
    ax.set_xlim(0, 1)
    all_nb = [max([net_benefit(y_true, yp, t) for t in thresholds]) for yp in proba_list]
    ax.set_ylim(-0.05, max([max(ta)]+all_nb)+0.05)
    ax.legend(loc='upper right', fontsize=9)
    ax.grid(True, alpha=0.3)
    ax.spines['top'].set_visible(False)
    ax.spines['right'].set_visible(False)
    plt.tight_layout()
    fn = f"{prefix}_dca_{ts}"
    save_plot(fn, fig)
    print(f"![DCA Curves](/plots/{fn}.png)\n")

def plot_calibration(y_true, proba_list, name_list, prefix, ts):
    if not proba_list:
        return
    n_cols = min(3, len(proba_list))
    n_rows = (len(proba_list)+n_cols-1)//n_cols if len(proba_list) > 0 else 1
    fig, axes = plt.subplots(n_rows, n_cols, figsize=(5*n_cols, 4*n_rows))
    axes_flat = axes.flatten() if n_rows*n_cols > 1 else [axes]
    for i, (name, yp) in enumerate(zip(name_list, proba_list)):
        ax = axes_flat[i]
        pt, pp = calibration_curve(y_true, yp, n_bins=10, strategy='uniform')
        brier = ((y_true-yp)**2).mean()
        ax.plot(pp, pt, 'o-', color='steelblue', ms=8, label=f'{name} (Brier={brier:.3f})')
        ax.plot([0,1], [0,1], '--', color='gray', label='Perfect')
        ax.set_xlabel('Predicted Probability')
        ax.set_ylabel('Observed Proportion')
        ax.set_title(name); ax.legend(fontsize=8); ax.grid(True, alpha=0.3)
    for j in range(len(proba_list), len(axes_flat)):
        axes_flat[j].set_visible(False)
    plt.tight_layout()
    fn = f"{prefix}_calibration_{ts}"
    save_plot(fn, fig)
    print(f"![Calibration](/plots/{fn}.png)\n")

