                    max_pval = row['p_value']
                    worst_pred = row['variable']
        if max_pval > 0.1 and worst_pred:
            current.remove(worst_pred)
            output_metrics["model_steps"].append({
                "step": step, "action": "removed",
                "variable": worst_pred, "p_value": float(max_pval)
            })
