        ci_lower = row['ci_lower']
        ci_upper = row['ci_upper']
        pval = row['p_value']
        sig = "**" if pval < 0.05 else ""
        if var == "Intercept":
            ci_str = "—"
            or_str = "—"
        else:
            ci_str = f"{ci_lower:.3f}–{ci_upper:.3f}" if ci_lower else "—"
            or_str = f"{or_val:.3f}" if or_val else "—"
        coef_str = f"{coef:.4f}"
        pval_str = f"{fmt_p(pval)}{sig}" if pval != 1.0 else "-"
        print(f"| {var} | {coef_str} | {or_str} | {ci_str} | {pval_str} |")

def build_equation(model, pred_list):
    if model is None or not pred_list:
        return None
    coefs = model.coef_[0]
    intercept = model.intercept_[0]
    terms = []
    expanded = get_expanded(pred_list)
    for i, pred in enumerate(expanded):
        if i >= len(coefs):
            break
        coef = coefs[i]
        sign = "+" if coef >= 0 else "-"
        terms.append(f"{sign} {abs(coef):.4f} &times; {display_name(pred)}")
    eq = " ".join(terms)
    if eq.startswith("+"):
        eq = eq[1:].strip()
    elif eq.startswith("-"):
        eq = "-" + eq[1:].strip()
    return f"logit(P) = {intercept:.4f} {eq}"

