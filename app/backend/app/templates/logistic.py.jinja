elif regression_type == "forward":
    print("### Forward Selection\n")
    
    selected = []
    remaining = valid_pred.copy()
    step = 1
    
    while remaining:
        best_pval = 1.0
        best_pred = None
        best_model = None
        
        for pred in remaining:
            test_preds = selected + [pred]
            model, X, y = fit_logistic(test_preds)
            if model is None:
                continue
            summary = get_model_summary(model, test_preds)
            for row in summary:
                if row['variable'] == pred:
                    pval = row['p_value']
                    if pval < best_pval:
                        best_pval = pval
                        best_pred = pred
                        best_model = model
                    break
        
        if best_pval < 0.05 and best_pred:
            selected.append(best_pred)
            remaining.remove(best_pred)
            output_metrics["model_steps"].append({
                "step": step, "action": "added",
                "variable": best_pred, "p_value": float(best_pval)
            })
            print(f"Step {step}: + {best_pred} (p={best_pval:.4f})")
            step += 1
        else:
            break
    
    if selected:
