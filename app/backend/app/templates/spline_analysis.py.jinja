    for k, label in zip(knots, knot_labels):
        ax2.axvline(x=k, color='red', linestyle='--', linewidth=2, label=label)
    ax2.set_xlabel(variable)
    ax2.set_ylabel('Frequency')
    ax2.set_title('Distribution with Knots')
    ax2.legend(fontsize=8)
    
    plt.tight_layout()
