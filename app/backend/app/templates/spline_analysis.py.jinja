    beta_base = coefs[0] / log_scaler.scale_[0] if log_scaler.scale_[0] != 0 else 0
    log_odds = beta_base * (x_range - log_scaler.mean_[0])
    
    for i, k in enumerate(knots):
        col_idx = i + 1
        if col_idx < len(coefs):
            beta_k = coefs[col_idx] / log_scaler.scale_[col_idx] if log_scaler.scale_[col_idx] != 0 else 0
            log_odds += beta_k * np.maximum(x_range - k, 0)
    
    ax1.plot(x_range, log_odds, 'b-', linewidth=2, label='Log Odds')
    ax1.axhline(y=0, color='gray', linestyle='--', alpha=0.5)
    for k, label in zip(knots, knot_labels):
