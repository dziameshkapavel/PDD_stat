    print(f"**Events:** {n_events}")
print()

if n_total < 20:
    raise ValueError("Insufficient data")

# Определяем узел (узлы)
x = df_model[variable].values.ravel()
if knot_type == 'median':
    knots = [np.median(x)]
    knot_labels = [f"Median ({knots[0]:.1f})"]
elif knot_type == 'quartiles':
    knots = [np.percentile(x, 25), np.percentile(x, 50), np.percentile(x, 75)]
    knot_labels = [f"Q1 ({knots[0]:.1f})", f"Q2 ({knots[1]:.1f})", f"Q3 ({knots[2]:.1f})"]
else:
    knots = [custom_knot]
    knot_labels = [f"Custom ({knots[0]:.1f})"]

print(f"**Knots:** {', '.join(knot_labels)}\n")

# Создаём сплайн-переменные
for i, k in enumerate(knots):
    df_model[f'spline_{i+1}'] = np.maximum(x.ravel() - k, 0)

# Формула
spline_cols = [f'spline_{i+1}' for i in range(len(knots))]
all_preds = spline_cols + covariates

# Стандартизация
from sklearn.preprocessing import StandardScaler
scaler = StandardScaler()
X = df_model[all_preds].copy()
X_scaled = scaler.fit_transform(X)
X_scaled = pd.DataFrame(X_scaled, columns=all_preds)

if is_survival:
    # COX MODEL
    from lifelines import CoxPHFitter
    df_cox = df_model[[time_col, event_col, variable] + all_preds].copy()
    
    cph = CoxPHFitter()
    cph.fit(df_cox, duration_col=time_col, event_col=event_col)
    
    print("### Cox Model with Spline\n")
    print("| Segment | Knot | HR | 95% CI | p-value |")
    print("|---------|------|-----|--------|---------|")
    
    summary = cph.summary
    base_hr = float(summary.loc[variable, 'exp(coef)'])
    base_p = float(summary.loc[variable, 'p'])
    base_ci_low = float(summary.loc[variable, 'exp(coef) lower 95%'])
    base_ci_high = float(summary.loc[variable, 'exp(coef) upper 95%'])
    
    print(f"| Below first knot | — | {base_hr:.3f} | {base_ci_low:.3f}-{base_ci_high:.3f} | {fmt_p(base_p)} |")
    
    for i, k in enumerate(knots):
        col = f'spline_{i+1}'
        if col in summary.index:
            hr = float(summary.loc[col, 'exp(coef)'])
            p = float(summary.loc[col, 'p'])
            # Delta method: var(β_v + β_s) = var(β_v) + var(β_s) + 2*cov(β_v, β_s)
            beta_v = cph.params_[variable]
            beta_s = cph.params_[col]
            var_v = cph.variance_matrix_.loc[variable, variable]
            var_s = cph.variance_matrix_.loc[col, col]
            cov_vs = cph.variance_matrix_.loc[variable, col]
            var_sum = var_v + var_s + 2 * cov_vs
            se_sum = np.sqrt(var_sum)
            combined_hr = float(np.exp(beta_v + beta_s))
            ci_combined_low = float(np.exp(beta_v + beta_s - 1.96 * se_sum))
            ci_combined_high = float(np.exp(beta_v + beta_s + 1.96 * se_sum))
            print(f"| Above {knot_labels[i]} | {k:.1f} | {combined_hr:.3f} | {ci_combined_low:.3f}-{ci_combined_high:.3f} | {fmt_p(p)} |")
    
    # Тест нелинейности (LRT: полная модель vs модель без сплайнов)
    if len(knots) > 0:
        try:
            null_cph = CoxPHFitter()
            null_cph.fit(df_cox[[time_col, event_col, variable] + covariates], 
                        duration_col=time_col, event_col=event_col)
            
            ll_full = cph.log_likelihood_
            ll_null = null_cph.log_likelihood_
            lr_stat = 2 * (ll_full - ll_null)
            nonlin_p = float(1 - chi2.cdf(lr_stat, len(spline_cols)))
            print(f"\n**Non-linearity test (LRT):** χ² = {lr_stat:.2f}, df = {len(spline_cols)}, p = {fmt_p(nonlin_p)}{' **' if nonlin_p < 0.05 else ''}")
            if nonlin_p < 0.05:
                print("**Conclusion:** Significant non-linear association detected.")
            else:
                print("**Conclusion:** No evidence of non-linearity.")
        except:
            pass
    
    # График
    timestamp = str(int(time.time()))
    fig, axes = plt.subplots(1, 2, figsize=(14, 6))
    
    # Plot 1: Log HR
    ax1 = axes[0]
    x_range = np.linspace(x.min(), x.max(), 200)
    log_hr = np.zeros_like(x_range)
    
    beta_base = cph.params_[variable]
    log_hr = beta_base * x_range.ravel()
    
    for i, k in enumerate(knots):
        col = f'spline_{i+1}'
        if col in cph.params_:
            beta_k = cph.params_[col]
            log_hr += beta_k * np.maximum(x_range.ravel() - k, 0)
    
    ax1.plot(x_range, log_hr, 'b-', linewidth=2, label='Log HR')
    ax1.axhline(y=0, color='gray', linestyle='--', alpha=0.5)
    for k, label in zip(knots, knot_labels):
        ax1.axvline(x=k, color='red', linestyle='--', alpha=0.7, label=label)
    ax1.set_xlabel(variable)
    ax1.set_ylabel('Log Hazard Ratio')
    ax1.set_title('Spline: Log HR vs Variable')
    ax1.legend(fontsize=8)
    ax1.grid(True, alpha=0.3)
    
    # Plot 2: Histogram
    ax2 = axes[1]
    ax2.hist(x, bins=30, color='steelblue', edgecolor='white', alpha=0.7)
    for k, label in zip(knots, knot_labels):
        ax2.axvline(x=k, color='red', linestyle='--', linewidth=2, label=label)
    ax2.set_xlabel(variable)
    ax2.set_ylabel('Frequency')
    ax2.set_title('Distribution with Knots')
    ax2.legend(fontsize=8)
    
    plt.tight_layout()
    plot_name = f"spline_{timestamp}"
    save_plot(plot_name, fig)
    print(f"\n![Spline Plot](/plots/{plot_name}.png)\n")

else:
    # LOGISTIC MODEL
    from sklearn.linear_model import LogisticRegression
    
    y = df_model[target_col].values
    
    # Логистическая модель: variable + spline_terms + covariates
    X_log = df_model[[variable] + all_preds].copy()
    log_scaler = StandardScaler()
    X_log_scaled = log_scaler.fit_transform(X_log)
    
    lr = LogisticRegression(max_iter=1000, random_state=42)
    lr.fit(X_log_scaled, y)
    
    print("### Logistic Model with Spline\n")
    print("| Segment | Knot | OR | 95% CI | p-value |")
    print("|---------|------|-----|--------|---------|")
    
    # Приближённые p-value через bootstrap
    from scipy import stats as scipy_stats
    
    coefs = lr.coef_[0]
    intercept = lr.intercept_[0]
    
    # Bootstrap для SE
    n_boot = 500
    boot_coefs = []
    np.random.seed(42)
    for _ in range(n_boot):
        idx = np.random.choice(len(y), len(y), replace=True)
        Xb = X_log_scaled[idx]
        yb = y[idx]
        try:
            lrb = LogisticRegression(max_iter=1000, random_state=42)
            lrb.fit(Xb, yb)
            boot_coefs.append(lrb.coef_[0])
        except:
            continue
    
    boot_coefs = np.array(boot_coefs)
    se = boot_coefs.std(axis=0)
    z_scores = coefs / se
    p_values = 2 * (1 - scipy_stats.norm.cdf(np.abs(z_scores)))
    
    # coefs[0] = variable (linear effect)
    base_or = float(np.exp(coefs[0]))
    base_p = float(p_values[0])
    print(f"| Below first knot | — | {base_or:.3f} | — | {fmt_p(base_p)} |")
    
    for i, k in enumerate(knots):
        col_idx = i + 1  # coefs[1] = spline_1, coefs[2] = spline_2, ...
        if col_idx < len(coefs):
            or_val = float(np.exp(coefs[col_idx]))
            p_val = float(p_values[col_idx])
            combined_or = base_or * or_val
            print(f"| Above {knot_labels[i]} | {k:.1f} | {combined_or:.3f} | — | {fmt_p(p_val)} |")
    
    # Тест нелинейности (Wald на первом сплайн-терме)
    if len(knots) > 0 and len(coefs) > 1:
        nonlin_p = float(p_values[1])
        print(f"\n**Non-linearity test:** p = {fmt_p(nonlin_p)}{' **' if nonlin_p < 0.05 else ''}")
        if nonlin_p < 0.05:
            print("**Conclusion:** Significant non-linear association detected.")
        else:
            print("**Conclusion:** No evidence of non-linearity.")
    
    # График
