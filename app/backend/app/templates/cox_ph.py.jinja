                pval = pval_row.values[0]
                if pval != "-" and pval > max_pval:
                    max_pval = pval
                    worst_cov = cov
        
        if max_pval > 0.1 and worst_cov:
            current.remove(worst_cov)
            step_info = {
                "step": step_num,
                "action": "removed",
                "variable": str(worst_cov),
                "p_value": float(max_pval)
            }
            output_metrics["model_steps"].append(step_info)
            print(f"- `{worst_cov}`: p = {max_pval:.4f} → исключён")
