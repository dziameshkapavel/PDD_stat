def fit_cox(covariates_to_fit):
    if not covariates_to_fit:
        return None
    cph = CoxPHFitter()
    try:
        cph.fit(df_cox[[time_col, event_col] + covariates_to_fit], duration_col=time_col, event_col=event_col)
        return cph
    except Exception as e:
        output_metrics["warnings"].append(f"Model fitting failed: {str(e)}")
        return None

def build_table_data(cph):
    if cph is None:
        return []
    
    summary = cph.summary.copy()
    summary.index.name = 'Variable'
    summary = summary.reset_index()
    
    rows = []
    inserted_references = set()
    
    for _, row in summary.iterrows():
        var_name = row['Variable']
        
        if var_name in dummy_to_info:
            info = dummy_to_info[var_name]
            orig_col = info['original']
            cat_name = info['category']
            ref_name = info['reference']
            
            if orig_col not in inserted_references:
                rows.append({
                    "variable": f"{orig_col} [{ref_name}] (reference)",
                    "beta": 0.0,
                    "se": None,
                    "z": None,
                    "hr": 1.0,
                    "ci": "—",
                    "ci_lower": 1.0,
                    "ci_upper": 1.0,
                    "p_value": None,
                    "is_reference": True
                })
                inserted_references.add(orig_col)
            
            ci_low = float(row['exp(coef) lower 95%'])
            ci_high = float(row['exp(coef) upper 95%'])
            rows.append({
                "variable": f"{orig_col} [{cat_name} vs {ref_name}]",
                "beta": float(row['coef']),
                "se": float(row['se(coef)']),
                "z": float(row['z']),
                "hr": float(row['exp(coef)']),
                "ci": f"{ci_low:.3f}–{ci_high:.3f}",
                "ci_lower": ci_low,
                "ci_upper": ci_high,
                "p_value": float(row['p']) if pd.notna(row['p']) else None,
                "is_reference": False
            })
        else:
            ci_low = float(row['exp(coef) lower 95%'])
            ci_high = float(row['exp(coef) upper 95%'])
            rows.append({
                "variable": var_name,
                "beta": float(row['coef']),
                "se": float(row['se(coef)']),
                "z": float(row['z']),
                "hr": float(row['exp(coef)']),
                "ci": f"{ci_low:.3f}–{ci_high:.3f}",
                "ci_lower": ci_low,
                "ci_upper": ci_high,
                "p_value": float(row['p']) if pd.notna(row['p']) else None,
                "is_reference": False
            })
            
    return rows

def calculate_vif(covariates_list):
    if len(covariates_list) < 2:
        return {}
    try:
        from statsmodels.stats.outliers_influence import variance_inflation_factor
        X = df_cox[covariates_list].dropna()
        if X.shape[0] < 10 or X.shape[1] < 2:
            return {}
        vif_data = {}
        for i, col in enumerate(X.columns):
            try:
                vif = float(variance_inflation_factor(X.values, i))
                if np.isnan(vif) or np.isinf(vif):
                    vif = 999.0
                vif_data[str(col)] = {
                    "value": vif,
                    "high": bool(vif > 10),
                    "moderate": bool(vif > 5 and vif <= 10)
                }
            except:
                vif_data[str(col)] = {"value": 0.0, "high": False, "moderate": False}
        return vif_data
    except Exception as e:
        output_metrics["warnings"].append(f"VIF error: {str(e)}")
        return {}

def run_schoenfeld_multivariate(cph, covariates_list):
    try:
        from lifelines.statistics import proportional_hazard_test
        results = proportional_hazard_test(cph, df_cox[[time_col, event_col] + covariates_list], p_value_threshold=0.05)
        
        schoenfeld = {}
        for i, var in enumerate(results.name):
            p_val = float(results.p_value[i])
            schoenfeld[str(var)] = {
                "p_value": p_val,
                "test_statistic": float(results.test_statistic[i]),
                "violated": bool(p_val < 0.05)
            }
        schoenfeld["GLOBAL"] = {
            "p_value": float(results.p_value[-1]) if len(results.p_value) > 0 else 1.0,
            "test_statistic": float(results.test_statistic[-1]) if len(results.test_statistic) > 0 else 0.0,
            "violated": bool((float(results.p_value[-1]) if len(results.p_value) > 0 else 1.0) < 0.05)
        }
        return schoenfeld
    except Exception as e:
        output_metrics["warnings"].append(f"Schoenfeld test error: {str(e)}")
        return {}

def build_equation(cph):
    if cph is None or not hasattr(cph, 'params_'):
        return None
    try:
        terms = []
        for coef_name, coef_val in cph.params_.items():
            display_name = coef_name
            if coef_name in dummy_to_info:
                info = dummy_to_info[coef_name]
                display_name = f"{info['original']}[{info['category']}]"
            
            sign = "+" if coef_val >= 0 else "-"
            abs_val = abs(coef_val)
            terms.append(f"{sign} {abs_val:.4f} &times; {display_name}")
        
        equation_terms = " ".join(terms)
        if equation_terms.startswith("+"):
            equation_terms = equation_terms[1:].strip()
        elif equation_terms.startswith("-"):
            equation_terms = "-" + equation_terms[1:].strip()
            
        return f"h(t) = h<sub>0</sub>(t) &times; exp( {equation_terms} )"
    except Exception as e:
        return f"Error building formula: {str(e)}"

