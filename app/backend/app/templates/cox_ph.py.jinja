# ==================== STEPWISE SELECTION ====================
elif regression_type in ["forward", "backward"]:
    print(f"### Stepwise Selection ({'Forward selection' if regression_type == 'forward' else 'Backward elimination'})\n")
    print("⚠️ **Note:** Stepwise selection uses p-values for variable selection.")
    print("   P-values in the final model **do not account for the selection process** and may be inflated.")
    print("   C-index computed on training data and is **optimistic**.")
    print("   Consider LASSO (L1-regularization) or Random Survival Forest.\n")
    
    def get_model_info(vars_list):
        if not vars_list:
            return None
        covs = []
        for v in vars_list:
            if v in encoding_map:
                covs.extend(encoding_map[v]['dummy_cols'])
            else:
                covs.append(v)
        cph = fit_cox(covs)
        return cph

    first_var = valid_cov[0]
    first_cph = get_model_info([first_var])
    if first_cph:
        null_ll = first_cph.log_likelihood_ - 0.5 * first_cph.log_likelihood_ratio_test().test_statistic
    else:
        null_ll = -9999.0
        
    step_num = 1
    selected_vars = []
    
    if regression_type == "forward":
        remaining_vars = valid_cov.copy()
        
        while remaining_vars:
            best_p = 1.0
            best_var = None
            best_cph = None
            
            if not selected_vars:
                base_ll = null_ll
                base_df = 0
            else:
                base_model = get_model_info(selected_vars)
                base_ll = base_model.log_likelihood_ if base_model else null_ll
                base_df = len(base_model.params_) if base_model else 0
                
            for var in remaining_vars:
                test_model = get_model_info(selected_vars + [var])
                if test_model is None:
                    continue
                
                test_ll = test_model.log_likelihood_
                test_df = len(test_model.params_)
                
                lrt_stat = 2 * (test_ll - base_ll)
                df_diff = test_df - base_df
                
                if df_diff > 0:
                    p_val = chi2.sf(lrt_stat, df=df_diff)
                    if p_val < best_p:
                        best_p = p_val
                        best_var = var
                        best_cph = test_model
            
            if best_p < p_enter and best_var:
                selected_vars.append(best_var)
                remaining_vars.remove(best_var)
                
                step_info = {
                    "step": step_num,
                    "action": "added",
                    "variable": str(best_var),
                    "p_value": float(best_p)
                }
                output_metrics["model_steps"].append(step_info)
                print(f"+ `{best_var}` added (p = {fmt_p(best_p)})")
                step_num += 1
            else:
                break
                
    else: # backward
        selected_vars = valid_cov.copy()
        
        while len(selected_vars) > 1:
            worst_p = -1.0
            worst_var = None
            
            full_model = get_model_info(selected_vars)
            if full_model is None:
                break
            full_ll = full_model.log_likelihood_
            full_df = len(full_model.params_)
            
            for var in selected_vars:
                reduced_vars = [v for v in selected_vars if v != var]
                reduced_model = get_model_info(reduced_vars)
                
                reduced_ll = reduced_model.log_likelihood_ if reduced_model else null_ll
                reduced_df = len(reduced_model.params_) if reduced_model else 0
                
                lrt_stat = 2 * (full_ll - reduced_ll)
                df_diff = full_df - reduced_df
                
                if df_diff > 0:
                    p_val = chi2.sf(lrt_stat, df=df_diff)
                    if p_val > worst_p:
                        worst_p = p_val
                        worst_var = var
            
            if worst_p > p_remove and worst_var:
                selected_vars.remove(worst_var)
                
                step_info = {
                    "step": step_num,
                    "action": "removed",
                    "variable": str(worst_var),
                    "p_value": float(worst_p)
                }
                output_metrics["model_steps"].append(step_info)
                print(f"- `{worst_var}` removed (p = {fmt_p(worst_p)})")
                step_num += 1
            else:
                break
                
    if selected_vars:
        final_covs = []
        for v in selected_vars:
            if v in encoding_map:
                final_covs.extend(encoding_map[v]['dummy_cols'])
            else:
                final_covs.append(v)
                
        final_cph = fit_cox(final_covs)
        if final_cph:
            output_metrics["c_index"] = float(final_cph.concordance_index_)
            output_metrics["aic"] = float(final_cph.AIC_partial_)
            output_metrics["bic"] = -2 * float(final_cph.log_likelihood_) + len(final_cph.params_) * np.log(len(df_work))
            output_metrics["log_likelihood"] = float(final_cph.log_likelihood_)
            output_metrics["global_p_value"] = float(final_cph.log_likelihood_ratio_test().p_value)
            output_metrics["equation_html"] = build_equation(final_cph)
            
            output_metrics["schoenfeld_test"] = run_schoenfeld_multivariate(final_cph, final_covs)
            output_metrics["vif"] = calculate_vif(final_covs)
            output_metrics["table"] = build_table_data(final_cph)
            
            print(f"\n**Final model ({len(selected_vars)} predictors):**\n")
            print("| Variable | beta (coef) | SE | z | HR | 95% CI | p-value |")
            print("|------------|-------------|----|---|----|--------|--------|")
            for row in output_metrics["table"]:
                beta_str = f"{row['beta']:.3f}" if row['beta'] is not None else "0.000"
                se_str = f"{row['se']:.3f}" if row['se'] is not None else "—"
                z_str = f"{row['z']:.2f}" if row['z'] is not None else "—"
                sig = "**" if (row['p_value'] is not None and row['p_value'] < 0.05) else ""
                p_str = f"{fmt_p(row['p_value'])}{sig}" if row['p_value'] is not None else "—"
                print(f"| {row['variable']} | {beta_str} | {se_str} | {z_str} | {row['hr']:.3f} | {row['ci']} | {p_str} |")
            
            print(f"\n**Model metrics:**  ")
            print(f"   * **C-index:** {output_metrics['c_index']:.4f}  ")
            print(f"   * **AIC:** {output_metrics['aic']:.2f}  ")
            print(f"   * **BIC:** {output_metrics['bic']:.2f}  ")
            print(f"   * **Log-Likelihood:** {output_metrics['log_likelihood']:.2f}  ")
            print(f"   * **Likelihood Ratio Test p-value:** {fmt_p(output_metrics['global_p_value'])}  ")
            
            cph = final_cph
            encoded_covs = final_covs
    else:
        output_metrics["warnings"].append("No predictors entered the final model")
        cph = None


