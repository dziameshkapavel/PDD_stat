# ==================== FORWARD SELECTION ====================
elif regression_type == "forward":
    print("### Forward Selection (прямой пошаговый отбор)\n")
    print("*Добавление предикторов по одному (p < 0.05 для включения)*\n")
    
    selected = []
    remaining = valid_cov.copy()
    step_num = 1
    
    while remaining:
        best_pval = 1.0
        best_cov = None
        best_cph = None
        
        for cov in remaining:
            test_covs = selected + [cov]
            cph = fit_cox(test_covs)
            if cph is None:
                continue
            summary = get_summary_table(cph)
            if summary.empty:
                continue
            pval_row = summary[summary['Variable'].str.contains(cov, na=False)]['p']
            if len(pval_row) > 0:
                pval = pval_row.values[0]
                if pval != "-" and pval < best_pval:
                    best_pval = pval
                    best_cov = cov
                    best_cph = cph
        
        if best_pval < 0.05 and best_cov:
            selected.append(best_cov)
            remaining.remove(best_cov)
            step_info = {
                "step": step_num,
                "action": "added",
                "variable": str(best_cov),
                "p_value": float(best_pval)
            }
            output_metrics["model_steps"].append(step_info)
            print(f"+ `{best_cov}`: p = {best_pval:.4f}")
            step_num += 1
        else:
            break
    
    if selected:
        final_cph = fit_cox(selected)
        if final_cph:
            output_metrics["c_index"] = float(final_cph.concordance_index_)
            output_metrics["schoenfeld_test"] = calculate_schoenfeld_all(final_cph, selected)
