# ==================== BACKWARD ELIMINATION ====================
elif regression_type == "backward":
    print("### Backward Elimination (обратный пошаговый отбор)\n")
    print("*Удаление предикторов по одному (p > 0.1 для исключения)*\n")
    
    current = valid_cov.copy()
    step_num = 1
    
    while len(current) > 1:
        cph = fit_cox(current)
        if cph is None:
            break
            
        summary = get_summary_table(cph)
        if summary.empty:
            break
        
        max_pval = 0
        worst_cov = None
