            ax1.errorbar(hr_vals, y_pos, xerr=[xerr_lo, xerr_hi],
                          fmt='o', capsize=5, color='#2563eb', markersize=8, elinewidth=2, mfc='#2563eb', mec='#2563eb')
            ax1.axvline(x=1, color='#ef4444', linestyle='--', linewidth=1.5, alpha=0.8)
            ax1.set_yticks(list(y_pos))
            ax1.set_yticklabels(labels, fontsize=10)
            ax1.set_xlabel('Hazard Ratio (HR)', fontsize=11, fontweight='semibold')
            ax1.set_title('Forest Plot (Hazard Ratios)', fontsize=13, fontweight='bold', pad=15)
            ax1.grid(True, linestyle=':', alpha=0.6)
            
            x_max = max(1.5, np.max(cap_upper) * 1.1)
            ax1.set_xlim(0, x_max)
            for idx, row in enumerate(plot_df.itertuples()):
                pval_str = f"p={fmt_p(row.p_value)}" if row.p_value is not None else ""
                text_str = f"{row.hr:.2f} ({row.ci_lower:.2f}–{row.ci_upper:.2f}) {pval_str}"
                ax1.text(x_max * 0.98, idx, text_str, va='center', ha='right', fontsize=8.5,
                          bbox=dict(boxstyle="round,pad=0.3", fc="#f3f4f6", ec="none", alpha=0.8))
    except Exception as forest_err:
        output_metrics["warnings"].append(f"Forest plot error: {str(forest_err)}")
        ax1.text(0.5, 0.5, 'Forest plot error', ha='center', va='center', transform=ax1.transAxes)
                      
    # 2. Выживаемость
    if plot_adjust_var and plot_adjust_var in encoding_map:
        try:
            info = encoding_map[plot_adjust_var]
            categories = info['categories']
            ref_group = info['reference']
            
            mean_X = df_cox[encoded_covs].mean()
            
            category_rows = []
            for cat in categories:
                row_data = mean_X.copy()
                for dummy in info['dummy_cols']:
                    if dummy in row_data:
                        row_data[dummy] = 0
                if cat != ref_group:
                    dummy_col = f"{plot_adjust_var}_{cat}"
                    if dummy_col in row_data:
                        row_data[dummy_col] = 1
                category_rows.append(row_data)
                
            X_plot = pd.DataFrame(category_rows, index=categories)
            surv = cph.predict_survival_function(X_plot)
            
            for col_cat in surv.columns:
                ax2.plot(surv.index, surv[col_cat], label=f"{plot_adjust_var}: {col_cat}", linewidth=2)
                
            ax2.set_xlabel('Time', fontsize=11, fontweight='semibold')
            ax2.set_ylabel('Adjusted Survival', fontsize=11, fontweight='semibold')
            ax2.set_title(f'Survival by {plot_adjust_var}', fontsize=13, fontweight='bold', pad=15)
            ax2.legend(loc='lower left', frameon=True)
            ax2.grid(True, linestyle=':', alpha=0.6)
            ax2.set_ylim(0, 1.02)
        except Exception as e:
            output_metrics["warnings"].append(f"Survival curve plotting failed: {str(e)}")
            cph.baseline_cumulative_hazard_.plot(ax=ax2, color='#2563eb', linewidth=2, legend=False)
            ax2.set_xlabel('Time')
            ax2.set_ylabel('Baseline Cumulative Hazard')
            ax2.grid(True, alpha=0.3)
    else:
        cph.baseline_cumulative_hazard_.plot(ax=ax2, color='#2563eb', linewidth=2, legend=False)
        ax2.set_xlabel('Time', fontsize=11, fontweight='semibold')
        ax2.set_ylabel('Baseline Cumulative Hazard', fontsize=11, fontweight='semibold')
        ax2.set_title('Model Baseline Cumulative Hazard', fontsize=13, fontweight='bold', pad=15)
        ax2.grid(True, linestyle=':', alpha=0.6)
        
    # 3. Линейность (Martingale Residuals)
    if has_continuous:
        ax3 = axes[2]
        cont_var = continuous_vars[0]
        try:
            resids = cph.compute_residuals(df_cox[[time_col, event_col] + encoded_covs], kind='martingale')
            x_vals = df_work[cont_var]
            y_vals = resids['martingale']
            
            ax3.scatter(x_vals, y_vals, color='#4b5563', alpha=0.6, edgecolors='none', s=25)
            
            try:
                import statsmodels.api as sm
                lowess = sm.nonparametric.lowess
                smoothed = lowess(y_vals, x_vals, frac=0.66)
                ax3.plot(smoothed[:, 0], smoothed[:, 1], color='#ef4444', linewidth=2.5, label='LOWESS trend')
            except Exception as lowess_err:
                m, b = np.polyfit(x_vals, y_vals, 1)
                ax3.plot(x_vals, m*x_vals + b, color='#ef4444', linewidth=2, label='Linear trend')
                
            ax3.axhline(y=0, color='black', linestyle='--', alpha=0.5)
            ax3.set_xlabel(cont_var, fontsize=11, fontweight='semibold')
            ax3.set_ylabel('Martingale Residuals', fontsize=11, fontweight='semibold')
            ax3.set_title(f'Linearity check: {cont_var}', fontsize=13, fontweight='bold', pad=15)
            ax3.grid(True, linestyle=':', alpha=0.6)
            ax3.legend(loc='best')
        except Exception as mart_err:
            output_metrics["warnings"].append(f"Martingale plot error: {str(mart_err)}")
            ax3.text(0.5, 0.5, 'Error plotting residuals', ha='center', va='center')
        
    plt.tight_layout()
    plot_filename = f"cox_ph_{timestamp}"
    save_plot(plot_filename, fig)
    output_metrics["plots"] = [f"{plot_filename}.png"]
    print(f"\n![Cox PH](/plots/{plot_filename}.png)\n")

# ВАЖНО: Вывод метрик в JSON для бэкенда
output_metrics["n_total"] = len(df_cox)
output_metrics["n_events"] = n_events
output_metrics["time_col"] = time_col
output_metrics["event_col"] = event_col
output_metrics["covariates"] = valid_cov

output_metrics = make_json_serializable(output_metrics)
print("\n<!-- JSON_METRICS_START -->")
print(json.dumps(output_metrics, ensure_ascii=False))
print("<!-- JSON_METRICS_END -->")

print("---")
print("**Cox regression complete**")
