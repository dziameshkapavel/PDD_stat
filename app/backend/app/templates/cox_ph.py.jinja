        raise ValueError("Model fitting failed")
    
    output_metrics["c_index"] = float(cph.concordance_index_)
    output_metrics["aic"] = float(cph.AIC_partial_)
    output_metrics["bic"] = -2 * float(cph.log_likelihood_) + len(cph.params_) * np.log(len(df_work))
    output_metrics["log_likelihood"] = float(cph.log_likelihood_)
    output_metrics["global_p_value"] = float(cph.log_likelihood_ratio_test().p_value)
    output_metrics["equation_html"] = build_equation(cph)
    
    output_metrics["schoenfeld_test"] = run_schoenfeld_multivariate(cph, encoded_covs)
    output_metrics["vif"] = calculate_gvif(encoded_covs)
    output_metrics["table"] = build_table_data(cph)
    
    cont_vars = [c for c in valid_cov if c not in encoding_map]
    lin_warnings = check_linearity(cph, encoded_covs, cont_vars)
    for lw in lin_warnings:
        print(f"⚠️ {lw}")
        output_metrics["warnings"].append(lw)
    inf_warnings = check_influential_observations(cph, encoded_covs)
    for iw in inf_warnings[:5]:
        print(f"⚠️ {iw}")
        output_metrics["warnings"].append(iw)
    
    print("| Variable | beta (coef) | SE | z | HR | 95% CI | p-value |")
    print("|------------|-------------|----|---|----|--------|--------|")
    for row in output_metrics["table"]:
        beta_str = f"{row['beta']:.3f}" if row['beta'] is not None else "0.000"
        se_str = f"{row['se']:.3f}" if row['se'] is not None else "—"
        z_str = f"{row['z']:.2f}" if row['z'] is not None else "—"
        sig = "**" if (row['p_value'] is not None and row['p_value'] < 0.05) else ""
        p_str = f"{fmt_p(row['p_value'])}{sig}" if row['p_value'] is not None else "—"
        print(f"| {row['variable']} | {beta_str} | {se_str} | {z_str} | {row['hr']:.3f} | {row['ci']} | {p_str} |")
    
    print(f"\n**Model metrics:**  ")
    print(f"   * **C-index:** {output_metrics['c_index']:.4f}  ")
    print(f"   * **AIC (Akaike Info Criterion):** {output_metrics['aic']:.2f}  ")
    print(f"   * **BIC (Bayesian Info Criterion):** {output_metrics['bic']:.2f}  ")
    print(f"   * **Log-Likelihood:** {output_metrics['log_likelihood']:.2f}  ")
    print(f"   * **Likelihood Ratio Test p-value:** {fmt_p(output_metrics['global_p_value'])}{'**' if output_metrics['global_p_value'] < 0.05 else ''}  ")

# ==================== STEPWISE SELECTION ====================
elif regression_type in ["forward", "backward"]:
    print(f"### Stepwise Selection ({'Forward selection' if regression_type == 'forward' else 'Backward elimination'})\n")
    print("⚠️ **Note:** Stepwise selection uses p-values for variable selection.")
    print("   P-values in the final model **do not account for the selection process** and may be inflated.")
    print("   C-index computed on training data and is **optimistic**.")
    print("   Consider LASSO (L1-regularization) or Random Survival Forest.\n")
    output_metrics["warnings"].append("Stepwise selection: p-values do not account for the selection process and may be inflated.")
    output_metrics["warnings"].append("Stepwise selection: C-index is computed on training data and is optimistic.")
    
    def get_model_info(vars_list):
        if not vars_list:
            return None
        covs = []
        for v in vars_list:
            if v in encoding_map:
                covs.extend(encoding_map[v]['dummy_cols'])
            else:
                covs.append(v)
        cph = fit_cox(covs)
        return cph

    first_var = valid_cov[0]
    first_cph = get_model_info([first_var])
    if first_cph:
        null_ll = first_cph.log_likelihood_ - 0.5 * first_cph.log_likelihood_ratio_test().test_statistic
    else:
        null_ll = -9999.0
        
    step_num = 1
    selected_vars = []
    
    if regression_type == "forward":
        remaining_vars = valid_cov.copy()
        
        while remaining_vars:
            best_p = 1.0
            best_var = None
            best_cph = None
            
            if not selected_vars:
                base_ll = null_ll
                base_df = 0
            else:
                base_model = get_model_info(selected_vars)
                base_ll = base_model.log_likelihood_ if base_model else null_ll
                base_df = len(base_model.params_) if base_model else 0
                
            for var in remaining_vars:
                test_model = get_model_info(selected_vars + [var])
                if test_model is None:
                    continue
                
                test_ll = test_model.log_likelihood_
                test_df = len(test_model.params_)
                
                lrt_stat = 2 * (test_ll - base_ll)
                df_diff = test_df - base_df
                
                if df_diff > 0:
                    p_val = chi2.sf(lrt_stat, df=df_diff)
                    if p_val < best_p:
                        best_p = p_val
                        best_var = var
                        best_cph = test_model
            
            if best_p < p_enter and best_var:
                selected_vars.append(best_var)
                remaining_vars.remove(best_var)
                
                step_info = {
                    "step": step_num,
                    "action": "added",
                    "variable": str(best_var),
                    "p_value": float(best_p)
                }
                output_metrics["model_steps"].append(step_info)
                print(f"+ `{best_var}` added (p = {fmt_p(best_p)})")
                step_num += 1
            else:
                break
                
    else: # backward
        selected_vars = valid_cov.copy()
        
        while len(selected_vars) > 1:
            worst_p = -1.0
            worst_var = None
            
            full_model = get_model_info(selected_vars)
            if full_model is None:
                break
            full_ll = full_model.log_likelihood_
            full_df = len(full_model.params_)
            
            for var in selected_vars:
                reduced_vars = [v for v in selected_vars if v != var]
                reduced_model = get_model_info(reduced_vars)
                
                reduced_ll = reduced_model.log_likelihood_ if reduced_model else null_ll
                reduced_df = len(reduced_model.params_) if reduced_model else 0
                
                lrt_stat = 2 * (full_ll - reduced_ll)
                df_diff = full_df - reduced_df
                
                if df_diff > 0:
                    p_val = chi2.sf(lrt_stat, df=df_diff)
                    if p_val > worst_p:
                        worst_p = p_val
                        worst_var = var
            
            if worst_p > p_remove and worst_var:
                selected_vars.remove(worst_var)
                
                step_info = {
                    "step": step_num,
                    "action": "removed",
                    "variable": str(worst_var),
                    "p_value": float(worst_p)
                }
                output_metrics["model_steps"].append(step_info)
                print(f"- `{worst_var}` removed (p = {fmt_p(worst_p)})")
                step_num += 1
            else:
                break
                
    if selected_vars:
        final_covs = []
        for v in selected_vars:
            if v in encoding_map:
                final_covs.extend(encoding_map[v]['dummy_cols'])
            else:
                final_covs.append(v)
                
        final_cph = fit_cox(final_covs)
        if final_cph:
            output_metrics["c_index"] = float(final_cph.concordance_index_)
            output_metrics["aic"] = float(final_cph.AIC_partial_)
            output_metrics["bic"] = -2 * float(final_cph.log_likelihood_) + len(final_cph.params_) * np.log(len(df_work))
            output_metrics["log_likelihood"] = float(final_cph.log_likelihood_)
            output_metrics["global_p_value"] = float(final_cph.log_likelihood_ratio_test().p_value)
            output_metrics["equation_html"] = build_equation(final_cph)
            
            output_metrics["schoenfeld_test"] = run_schoenfeld_multivariate(final_cph, final_covs)
            output_metrics["vif"] = calculate_gvif(final_covs)
            output_metrics["table"] = build_table_data(final_cph)
            
            cont_vars = [c for c in selected_vars if c not in encoding_map]
            lin_warnings = check_linearity(final_cph, final_covs, cont_vars)
            for lw in lin_warnings:
                print(f"⚠️ {lw}")
                output_metrics["warnings"].append(lw)
            inf_warnings = check_influential_observations(final_cph, final_covs)
            for iw in inf_warnings[:5]:
                print(f"⚠️ {iw}")
                output_metrics["warnings"].append(iw)
            
            print(f"\n**Final model ({len(selected_vars)} predictors):**\n")
            print("| Variable | beta (coef) | SE | z | HR | 95% CI | p-value |")
            print("|------------|-------------|----|---|----|--------|--------|")
            for row in output_metrics["table"]:
                beta_str = f"{row['beta']:.3f}" if row['beta'] is not None else "0.000"
                se_str = f"{row['se']:.3f}" if row['se'] is not None else "—"
                z_str = f"{row['z']:.2f}" if row['z'] is not None else "—"
                sig = "**" if (row['p_value'] is not None and row['p_value'] < 0.05) else ""
                p_str = f"{fmt_p(row['p_value'])}{sig}" if row['p_value'] is not None else "—"
                print(f"| {row['variable']} | {beta_str} | {se_str} | {z_str} | {row['hr']:.3f} | {row['ci']} | {p_str} |")
            
            print(f"\n**Model metrics:**  ")
            print(f"   * **C-index:** {output_metrics['c_index']:.4f}  ")
            print(f"   * **AIC:** {output_metrics['aic']:.2f}  ")
            print(f"   * **BIC:** {output_metrics['bic']:.2f}  ")
            print(f"   * **Log-Likelihood:** {output_metrics['log_likelihood']:.2f}  ")
            print(f"   * **Likelihood Ratio Test p-value:** {fmt_p(output_metrics['global_p_value'])}  ")
            
            cph = final_cph
            encoded_covs = final_covs
    else:
        output_metrics["warnings"].append("No predictors entered the final model")
        cph = None


# ==================== ФУНКЦИЯ ГРАФИКА ОСТАТКОВ ШЁНФЕЛЬДА ====================
def plot_schoenfeld_residuals(cph, df_cox, time_col, event_col, encoded_covs, ax):
    """Scaled Schoenfeld residuals — все ковариаты на одной оси."""
    covs = list(cph.params_.index)
    try:
        schoenfeld = cph.compute_residuals(
            df_cox[[time_col, event_col] + covs].dropna(),
            kind='scaled_schoenfeld'
        )
        if schoenfeld.empty:
            ax.text(0.5, 0.5, 'No Schoenfeld residuals', ha='center', va='center', transform=ax.transAxes)
            return
        
        stats = output_metrics.get('schoenfeld_test', {})
        colors = ['#2563eb', '#dc2626', '#16a34a', '#d97706', '#7c3aed', '#0891b2', '#be185d', '#65a30d', '#0f766e']
        
        plot_vars = covs[:9]
        for idx, var in enumerate(plot_vars):
            if var not in schoenfeld.columns:
                continue
            times = schoenfeld.index.values
            resid = schoenfeld[var].values
            mask = np.isfinite(resid)
            times_f, resid_f = times[mask], resid[mask]
            if len(times_f) <= 5:
                continue
            
            c = colors[idx % len(colors)]
            ax.scatter(times_f, resid_f, color=c, alpha=0.3, s=10, edgecolors='none')
            
            sorted_idx = np.argsort(times_f)
            t_sorted = times_f[sorted_idx]
            r_sorted = resid_f[sorted_idx]
            try:
                import statsmodels.api as sm_api
                lowess = sm_api.nonparametric.lowess
                smoothed = lowess(r_sorted, t_sorted, frac=0.66, return_sorted=True)
                ax.plot(smoothed[:, 0], smoothed[:, 1], color=c, linewidth=2, label=var)
            except Exception:
                pass
        
        ax.axhline(y=0, color='black', linestyle='--', alpha=0.5)
        ax.set_xlabel('Time', fontsize=11, fontweight='semibold')
        ax.set_ylabel('Scaled Schoenfeld Residuals', fontsize=11, fontweight='semibold')
        
        global_p = None
        if isinstance(stats, dict):
            global_p = stats.get('global_p', None) if isinstance(stats.get('global_p'), (int, float)) else None
        gs = f' (global p={fmt_p(global_p)})' if global_p is not None else ''
        ax.set_title(f'Schoenfeld Residuals{gs}', fontsize=13, fontweight='bold', pad=15)
        ax.grid(True, linestyle=':', alpha=0.4)
        ax.legend(loc='best', fontsize=8)
    except Exception as e:
        output_metrics["warnings"].append(f"Schoenfeld plot error: {str(e)}")
        ax.text(0.5, 0.5, 'Schoenfeld plot error', ha='center', va='center', transform=ax.transAxes)


# ==================== ОТРИСОВКА ГРАФИКОВ ====================
if cph is not None and ('table' in output_metrics and output_metrics["table"]):
    timestamp = str(int(time.time()))
    
    continuous_vars = [c for c in selected_vars if c not in encoding_map] if 'selected_vars' in dir() else [c for c in valid_cov if c not in encoding_map]
    has_continuous = len(continuous_vars) > 0
    has_schoenfeld = output_metrics.get('schoenfeld_test') is not None
    
    # 2×2 grid
    fig = plt.figure(figsize=(14, 10))
    gs = gridspec.GridSpec(2, 2, figure=fig, hspace=0.3, wspace=0.3)
    
    ax1 = fig.add_subplot(gs[0, 0])  # Forest Plot
    ax2 = fig.add_subplot(gs[0, 1])  # Survival / Baseline Hazard
    
    # Forest Plot
    try:
        plot_df = pd.DataFrame(output_metrics["table"])
        plot_df = plot_df[~plot_df['is_reference']].copy()
        
        valid_mask = (
            plot_df['ci_lower'].notna() & plot_df['ci_upper'].notna() &
            plot_df['hr'].notna() & np.isfinite(plot_df['hr']) &
            np.isfinite(plot_df['ci_lower']) & np.isfinite(plot_df['ci_upper'])
        )
        plot_df = plot_df[valid_mask]
        
        if not plot_df.empty:
            plot_df = plot_df.iloc[::-1]
            y_pos = np.arange(len(plot_df))
            hr_vals = plot_df['hr'].values
            ci_low = plot_df['ci_lower'].values
            ci_high = plot_df['ci_upper'].values
            labels = plot_df['variable'].values
            
            cap_upper = np.minimum(ci_high, 10.0)
            
            xerr_lo = np.maximum(hr_vals - ci_low, 0)
            xerr_hi = np.maximum(cap_upper - hr_vals, 0)
            
            ax1.errorbar(hr_vals, y_pos, xerr=[xerr_lo, xerr_hi],
                          fmt='o', capsize=5, color='#2563eb', markersize=8, elinewidth=2, mfc='#2563eb', mec='#2563eb')
            ax1.axvline(x=1, color='#ef4444', linestyle='--', linewidth=1.5, alpha=0.8)
            ax1.set_yticks(list(y_pos))
            ax1.set_yticklabels(labels, fontsize=10)
            ax1.set_xlabel('Hazard Ratio (HR)', fontsize=11, fontweight='semibold')
            ax1.set_title('Forest Plot (Hazard Ratios)', fontsize=13, fontweight='bold', pad=15)
            ax1.grid(True, linestyle=':', alpha=0.6)
            
            x_max = max(1.5, np.max(cap_upper) * 1.1)
            ax1.set_xlim(0, x_max)
            for idx, row in enumerate(plot_df.itertuples()):
                pval_str = f"p={fmt_p(row.p_value)}" if row.p_value is not None else ""
                text_str = f"{row.hr:.2f} ({row.ci_lower:.2f}–{row.ci_upper:.2f}) {pval_str}"
                ax1.text(x_max * 0.98, idx, text_str, va='center', ha='right', fontsize=8.5,
                          bbox=dict(boxstyle="round,pad=0.3", fc="#f3f4f6", ec="none", alpha=0.8))
    except Exception as forest_err:
        output_metrics["warnings"].append(f"Forest plot error: {str(forest_err)}")
        ax1.text(0.5, 0.5, 'Forest plot error', ha='center', va='center', transform=ax1.transAxes)
                      
    # Survival
    if plot_adjust_var and plot_adjust_var in encoding_map:
        try:
            info = encoding_map[plot_adjust_var]
            categories = info['categories']
            ref_group = info['reference']
            
            mean_X = df_cox[encoded_covs].mean()
            
            category_rows = []
            for cat in categories:
                row_data = mean_X.copy()
                for dummy in info['dummy_cols']:
                    if dummy in row_data:
                        row_data[dummy] = 0
                if cat != ref_group:
                    dummy_col = f"{plot_adjust_var}_{cat}"
                    if dummy_col in row_data:
                        row_data[dummy_col] = 1
                category_rows.append(row_data)
                
            X_plot = pd.DataFrame(category_rows, index=categories)
            surv = cph.predict_survival_function(X_plot)
            
            for col_cat in surv.columns:
                ax2.plot(surv.index, surv[col_cat], label=f"{plot_adjust_var}: {col_cat}", linewidth=2)
                
            ax2.set_xlabel('Time', fontsize=11, fontweight='semibold')
            ax2.set_ylabel('Adjusted Survival', fontsize=11, fontweight='semibold')
            ax2.set_title(f'Survival by {plot_adjust_var}', fontsize=13, fontweight='bold', pad=15)
            ax2.legend(loc='lower left', frameon=True)
            ax2.grid(True, linestyle=':', alpha=0.6)
            ax2.set_ylim(0, 1.02)
        except Exception as e:
            output_metrics["warnings"].append(f"Survival curve plotting failed: {str(e)}")
            cph.baseline_cumulative_hazard_.plot(ax=ax2, color='#2563eb', linewidth=2, legend=False)
            ax2.set_xlabel('Time')
            ax2.set_ylabel('Baseline Cumulative Hazard')
            ax2.grid(True, alpha=0.3)
    else:
        cph.baseline_cumulative_hazard_.plot(ax=ax2, color='#2563eb', linewidth=2, legend=False)
        ax2.set_xlabel('Time', fontsize=11, fontweight='semibold')
        ax2.set_ylabel('Baseline Cumulative Hazard', fontsize=11, fontweight='semibold')
        ax2.set_title('Model Baseline Cumulative Hazard', fontsize=13, fontweight='bold', pad=15)
        ax2.grid(True, linestyle=':', alpha=0.6)
    
    # Строка 1: Schoenfeld или Linearity
    ax3 = fig.add_subplot(gs[1, :])  # Bottom row spans both columns
    
    if has_schoenfeld:
        # Schoenfeld residuals plot
        plot_schoenfeld_residuals(cph, df_cox, time_col, event_col, encoded_covs, ax3)
    elif has_continuous:
        # Martingale residuals (Linearity)
        cont_var = continuous_vars[0]
        try:
            resids = cph.compute_residuals(df_cox[[time_col, event_col] + encoded_covs], kind='martingale')
            x_vals = df_work[cont_var]
            y_vals = resids['martingale']
            
            ax3.scatter(x_vals, y_vals, color='#4b5563', alpha=0.6, edgecolors='none', s=25)
            
            try:
                import statsmodels.api as sm_api
                lowess = sm_api.nonparametric.lowess
                smoothed = lowess(y_vals, x_vals, frac=0.66)
                ax3.plot(smoothed[:, 0], smoothed[:, 1], color='#ef4444', linewidth=2.5, label='LOWESS trend')
            except Exception:
                m, b = np.polyfit(x_vals, y_vals, 1)
                ax3.plot(x_vals, m*x_vals + b, color='#ef4444', linewidth=2, label='Linear trend')
                
            ax3.axhline(y=0, color='black', linestyle='--', alpha=0.5)
            ax3.set_xlabel(cont_var, fontsize=11, fontweight='semibold')
            ax3.set_ylabel('Martingale Residuals', fontsize=11, fontweight='semibold')
            ax3.set_title(f'Linearity check: {cont_var}', fontsize=13, fontweight='bold', pad=15)
            ax3.grid(True, linestyle=':', alpha=0.6)
            ax3.legend(loc='best')
        except Exception as mart_err:
            output_metrics["warnings"].append(f"Martingale plot error: {str(mart_err)}")
            ax3.text(0.5, 0.5, 'Error plotting residuals', ha='center', va='center', transform=ax3.transAxes)
    else:
        ax3.text(0.5, 0.5, 'No PH diagnostics available', ha='center', va='center', transform=ax3.transAxes)
        ax3.set_title('PH Assumption Diagnostics', fontsize=13, fontweight='bold', pad=15)
        
    plt.tight_layout()
    plot_filename = f"cox_ph_{timestamp}"
    save_plot(plot_filename, fig)
    output_metrics["plots"] = [f"{plot_filename}.png"]
    print(f"\n![Cox PH](/plots/{plot_filename}.png)\n")

