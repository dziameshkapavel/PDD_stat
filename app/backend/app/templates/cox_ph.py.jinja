    else:
        output_metrics["warnings"].append("All predictors were excluded")

# ВАЖНО: Выводим метрики в JSON для парсинга бэкендом

# Добавляем детальные метрики для AI
output_metrics["n_total"] = len(df_cox)
output_metrics["n_events"] = n_events
output_metrics["time_col"] = time_col
output_metrics["event_col"] = event_col
output_metrics["covariates"] = valid_cov

if regression_type in ["multi", "enter"]:
    try:
        summary = get_summary_table(cph)
        if not summary.empty:
            output_metrics["coefficients"] = [
                {
                    "variable": row['Variable'],
                    "hr": float(row.get('exp(coef)', 1.0)),
                    "ci_lower": float(row.get('exp(coef) lower 95%', 1.0)),
                    "ci_upper": float(row.get('exp(coef) upper 95%', 1.0)),
                    "p_value": float(row.get('p', 1.0)) if row.get('p', '-') != '-' else 1.0
                }
                for _, row in summary.iterrows()
                if not row['Variable'].startswith('(baseline)')
            ]
            output_metrics["significant_predictors"] = [
                c for c in output_metrics["coefficients"] if c["p_value"] < 0.05
            ]
    except:
        pass

if regression_type == "forward" and ('selected' in dir() and selected):
    try:
        summary = get_summary_table(final_cph)
        if not summary.empty:
            output_metrics["coefficients"] = [
                {
                    "variable": row['Variable'],
                    "hr": float(row.get('exp(coef)', 1.0)),
                    "p_value": float(row.get('p', 1.0)) if row.get('p', '-') != '-' else 1.0
                }
                for _, row in summary.iterrows()
                if not row['Variable'].startswith('(baseline)')
            ]
    except:
        pass

if regression_type == "backward" and ('current' in dir() and current):
    try:
        summary = get_summary_table(final_cph)
        if not summary.empty:
            output_metrics["coefficients"] = [
                {
                    "variable": row['Variable'],
                    "hr": float(row.get('exp(coef)', 1.0)),
                    "p_value": float(row.get('p', 1.0)) if row.get('p', '-') != '-' else None
                }
                for _, row in summary.iterrows()
                if not str(row['Variable']).startswith('(baseline)')
            ]
    except:
        pass

if regression_type == "uni":
    output_metrics["n_predictors_tested"] = len(valid_cov)

output_metrics = make_json_serializable(output_metrics)
print("\n<!-- JSON_METRICS_START -->")
print(json.dumps(output_metrics, ensure_ascii=False))
print("<!-- JSON_METRICS_END -->")

print("---")
print("**Cox regression complete**")
