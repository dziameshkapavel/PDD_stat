def fit_cox(covariates_to_fit, label=""):
    if not covariates_to_fit:
        return None
    cph = None
    convergence_warnings = []
    
    # Пытаемся обучить без регуляризации, затем с возрастающим penalizer для стабильности
    fitted = False
    last_err = ""
    for pen in [0.0, 0.01, 0.1, 0.5]:
        with warnings.catch_warnings(record=True) as w:
            warnings.simplefilter("always")
            try:
                cph = CoxPHFitter(penalizer=pen)
                cph.fit(df_cox[[time_col, event_col] + covariates_to_fit], duration_col=time_col, event_col=event_col)
                fitted = True
                for warning in w:
                    if "convergen" in str(warning.message).lower():
                        convergence_warnings.append(str(warning.message))
                if pen > 0:
                    msg = f"Model fitted with L2 regularization (penalizer={pen}) due to convergence issues"
                    output_metrics["warnings"].append(msg)
                    print(f"ℹ️ {msg}")
                break
            except Exception as e:
                last_err = str(e)
                continue
                
    if not fitted:
        msg = f"Model fitting failed {label}: {last_err}"
        output_metrics["warnings"].append(msg)
        return None

    if convergence_warnings:
        for cw in convergence_warnings[:3]:
            output_metrics["warnings"].append(f"Convergence issue {label}: {cw[:200]}")
        print(f"⚠️ Model convergence issues detected {label}. See warnings.")
    if hasattr(cph, 'converged_') and not cph.converged_:
        msg = f"Model did not converge {label}({len(covariates_to_fit)} params)"
        output_metrics["warnings"].append(msg)
        print(f"⚠️ {msg}")
        return None
    return cph

def build_table_data(cph):
    if cph is None:
        return []
    
    summary = cph.summary.copy()
    summary.index.name = 'Variable'
    summary = summary.reset_index()
    
    rows = []
    inserted_references = set()
    
    for _, row in summary.iterrows():
        var_name = row['Variable']
        
        if var_name in dummy_to_info:
            info = dummy_to_info[var_name]
            orig_col = info['original']
            cat_name = info['category']
            ref_name = info['reference']
            
            if orig_col not in inserted_references:
                rows.append({
                    "variable": f"{orig_col} [{ref_name}] (reference)",
                    "beta": 0.0,
                    "se": None,
                    "z": None,
                    "hr": 1.0,
                    "ci": "—",
                    "ci_lower": 1.0,
                    "ci_upper": 1.0,
                    "p_value": None,
                    "is_reference": True
                })
                inserted_references.add(orig_col)
            
            ci_low = float(row['exp(coef) lower 95%'])
            ci_high = float(row['exp(coef) upper 95%'])
            rows.append({
                "variable": f"{orig_col} [{cat_name} vs {ref_name}]",
                "beta": float(row['coef']),
                "se": float(row['se(coef)']),
                "z": float(row['z']),
                "hr": float(row['exp(coef)']),
                "ci": f"{ci_low:.3f}–{ci_high:.3f}",
                "ci_lower": ci_low,
                "ci_upper": ci_high,
                "p_value": float(row['p']) if pd.notna(row['p']) else None,
                "is_reference": False
            })
        else:
            ci_low = float(row['exp(coef) lower 95%'])
            ci_high = float(row['exp(coef) upper 95%'])
            rows.append({
                "variable": var_name,
                "beta": float(row['coef']),
                "se": float(row['se(coef)']),
                "z": float(row['z']),
                "hr": float(row['exp(coef)']),
                "ci": f"{ci_low:.3f}–{ci_high:.3f}",
                "ci_lower": ci_low,
                "ci_upper": ci_high,
                "p_value": float(row['p']) if pd.notna(row['p']) else None,
                "is_reference": False
            })
            
    return rows

def calculate_gvif(covariates_list):
    """GVIF (Generalized VIF) — корректный VIF для категориальных с >2 уровней.
    Для дамми-переменных одной категории группирует их и вычисляет GVIF.
    """
    if len(covariates_list) < 2:
        return {}
    try:
        from statsmodels.stats.outliers_influence import variance_inflation_factor
        X = df_cox[covariates_list].dropna()
        if X.shape[0] < 10 or X.shape[1] < 2:
            return {}
        
        # Группируем колонки по исходным переменным
        var_groups = {}
        for col in covariates_list:
            if col in dummy_to_info:
                orig = dummy_to_info[col]['original']
                var_groups.setdefault(orig, []).append(col)
            else:
                var_groups[col] = [col]
        
        gvif_data = {}
        corr_matrix = np.corrcoef(X.values.T) if X.shape[1] >= 2 else np.array([[1.0]])
        
        for var_name, cols in var_groups.items():
            if not cols:
                continue
            indices = [list(X.columns).index(c) for c in cols if c in X.columns]
            if not indices:
                continue
            df_var = len(cols) - 1
            try:
                if df_var == 0:
                    # Непрерывная переменная — обычный VIF
                    idx = indices[0]
                    vif = float(variance_inflation_factor(X.values, idx))
                    if np.isnan(vif) or np.isinf(vif):
                        vif = 999.0
                    gvif = vif
                else:
                    # Категориальная — GVIF
                    R2_cov = 0.0
                    other_indices = [i for i in range(X.shape[1]) if i not in indices]
                    if len(other_indices) >= 1:
                        y_block = X.values[:, indices]
                        X_other = X.values[:, other_indices]
                        X_other_const = np.column_stack([X_other, np.ones(len(X_other))])
                        beta = np.linalg.lstsq(X_other_const, y_block, rcond=None)[0]
                        y_pred = X_other_const @ beta
                        ss_res = np.sum((y_block - y_pred) ** 2)
                        ss_tot = np.sum((y_block - np.mean(y_block, axis=0)) ** 2)
                        R2_cov = 1.0 - min(ss_res / (ss_tot + 1e-10), 1.0)
                    gvif = float(1.0 / (1.0 - R2_cov)) if R2_cov < 0.999 else 999.0
                    gvif_adjusted = float(gvif ** (1.0 / (2.0 * (df_var + 1))))
                
                is_high = bool(gvif > 10 if df_var == 0 else gvif_adjusted > 2.0)
                is_moderate = bool(
                    (5 < gvif <= 10) if df_var == 0 else (1.5 < gvif_adjusted <= 2.0)
                )
                
                entry = {
                    "value": float(f"{gvif:.3f}"),
                    "gvif_adjusted": float(f"{gvif_adjusted:.3f}") if df_var > 0 else None,
                    "df": df_var + 1,
                    "high": is_high,
                    "moderate": is_moderate
                }
                gvif_data[var_name] = entry
            except:
                gvif_data[var_name] = {"value": 0.0, "gvif_adjusted": None, "df": df_var + 1, "high": False, "moderate": False}
        return gvif_data
    except Exception as e:
        output_metrics["warnings"].append(f"GVIF error: {str(e)}")
        return {}

def check_linearity(cph, covariates_list, continuous_vars):
    warnings_list = []
    if not continuous_vars or cph is None:
        return warnings_list
    try:
        resids = cph.compute_residuals(df_cox[[time_col, event_col] + covariates_list], kind='martingale')
        for var in continuous_vars[:3]:
            if var not in df_work.columns:
                continue
            x_vals = df_work[var]
            y_vals = resids['martingale']
            mask = x_vals.notna() & y_vals.notna()
            x_sub = x_vals[mask]
            y_sub = y_vals[mask]
            if len(x_sub) < 10:
                continue
            corr, _ = scipy.stats.spearmanr(x_sub, y_sub)
            if abs(corr) > 0.15:
                msg = f"Non-linearity possible: {var} (Spearman ρ={corr:.3f} between predictor and Martingale residuals)"
                warnings_list.append(msg)
        try:
            import statsmodels.api as sm_api
            lowess = sm_api.nonparametric.lowess
            smoothed = lowess(y_sub, x_sub, frac=0.66)
            if len(smoothed) > 10:
                max_dev = np.max(np.abs(smoothed[:, 1]))
                if max_dev > 0.5:
                    msg = f"LOWESS deviation detected for {var} (max residual dev={max_dev:.2f}) — consider spline transformation"
                    if msg not in warnings_list:
                        warnings_list.append(msg)
        except Exception:
            pass
    except Exception:
        pass
    return warnings_list

def check_influential_observations(cph, covariates_list):
    warnings_list = []
    try:
        dfbeta = cph.compute_residuals(df_cox[[time_col, event_col] + covariates_list], kind='dfbeta')
        for col in dfbeta.columns:
            vals = dfbeta[col].abs().dropna()
            if len(vals) < 5:
                continue
            threshold = 2 * np.sqrt(len(covariates_list) / len(vals)) if len(vals) > 0 else 0.5
            influential = vals[vals > threshold]
            if len(influential) > 0:
                top_idx = influential.index[0]
                top_val = influential.iloc[0]
                warnings_list.append(f"Influential observation for {col}: index {top_idx} (dfbeta={top_val:.3f})")
    except Exception:
        pass
    return warnings_list

def run_schoenfeld_multivariate(cph, covariates_list):
    try:
        from lifelines.statistics import proportional_hazard_test
        results = proportional_hazard_test(cph, df_cox[[time_col, event_col] + covariates_list], p_value_threshold=0.05)
        
        schoenfeld = {}
        for i, var in enumerate(results.name):
            p_val = float(results.p_value[i])
            violated = bool(p_val < 0.05)
            schoenfeld[str(var)] = {
                "p_value": p_val,
                "test_statistic": float(results.test_statistic[i]),
                "violated": violated
            }
            if violated and str(var) != "GLOBAL":
                msg = f"Proportional hazards assumption violated for covariate '{var}' (p = {p_val:.4f}). Consider stratifying by this variable if it is categorical."
                print(f"⚠️ {msg}")
                output_metrics["warnings"].append(msg)
                
        global_p = float(results.p_value[-1]) if len(results.p_value) > 0 else 1.0
        global_violated = bool(global_p < 0.05)
        schoenfeld["GLOBAL"] = {
            "p_value": global_p,
            "test_statistic": float(results.test_statistic[-1]) if len(results.test_statistic) > 0 else 0.0,
            "violated": global_violated
        }
        if global_violated:
            msg = f"Global proportional hazards assumption violated (p = {global_p:.4f})."
            print(f"⚠️ {msg}")
            output_metrics["warnings"].append(msg)
            
        return schoenfeld
    except Exception as e:
        output_metrics["warnings"].append(f"Schoenfeld test error: {str(e)}")
        return {}

def build_equation(cph):
    if cph is None or not hasattr(cph, 'params_'):
        return None
    try:
        terms = []
        for coef_name, coef_val in cph.params_.items():
            display_name = coef_name
            if coef_name in dummy_to_info:
                info = dummy_to_info[coef_name]
                display_name = f"{info['original']}[{info['category']}]"
            
            sign = "+" if coef_val >= 0 else "-"
            abs_val = abs(coef_val)
            terms.append(f"{sign} {abs_val:.4f} &times; {display_name}")
        
        equation_terms = " ".join(terms)
        if equation_terms.startswith("+"):
            equation_terms = equation_terms[1:].strip()
        elif equation_terms.startswith("-"):
            equation_terms = "-" + equation_terms[1:].strip()
            
        return f"h(t) = h<sub>0</sub>(t) &times; exp( {equation_terms} )"
    except Exception as e:
        return f"Error building formula: {str(e)}"

