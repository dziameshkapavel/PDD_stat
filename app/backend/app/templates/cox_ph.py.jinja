def fit_cox(cov_list):
    if not cov_list:
        return None
    df_temp = df_cox[[time_col, event_col] + cov_list].dropna()
    if len(df_temp) < 10:
        return None
    cph = CoxPHFitter()
    try:
        cph.fit(df_temp, duration_col=time_col, event_col=event_col)
        return cph
    except Exception as e:
        output_metrics["warnings"].append(f"Model fitting failed: {str(e)}")
        return None

def get_summary_table(cph):
    if cph is None:
        return pd.DataFrame()
    summary = cph.summary.copy()
    summary.index.name = 'Variable'
    summary = summary.reset_index()
    for idx, row in summary.iterrows():
        var = row['Variable']
        if var in encoding_map:
            try:
                baseline = encoding_map[var].get(0, 'Baseline')
                hr_val = row.get('exp(coef)', 0)
                current_val = int(round(hr_val)) if pd.notna(hr_val) else 0
                if current_val in encoding_map[var]:
                    current_name = encoding_map[var][current_val]
                    if current_val == 0:
                        summary.loc[idx, 'Variable'] = f"{var} [{current_name}]"
                        summary.loc[idx, 'exp(coef)'] = 1.0
                        summary.loc[idx, 'exp(coef) lower 95%'] = 1.0
                        summary.loc[idx, 'exp(coef) upper 95%'] = 1.0
                        summary.loc[idx, 'p'] = 1.0
                    else:
                        summary.loc[idx, 'Variable'] = f"{var} [{current_name} vs {baseline}]"
            except:
                pass
    return summary

def run_schoenfeld_test_single(cph, covariate):
    """Запуск теста Шонфельда для одной переменной"""
    try:
        from lifelines.statistics import proportional_hazard_test
        
        # Создаём временную модель с одной переменной
        df_single = df_cox[[time_col, event_col, covariate]].dropna()
        if len(df_single) < 10:
            return {"p_value": 1.0, "test_statistic": 0.0, "violated": False}
        
        cph_single = CoxPHFitter()
        cph_single.fit(df_single, duration_col=time_col, event_col=event_col)
        
        # Запускаем тест
        results = proportional_hazard_test(cph_single, df_single, p_value_threshold=0.05, show_plots=False)
        
        p_value = 1.0
        test_stat = 0.0
        
        # Обрабатываем разные форматы результата
        if hasattr(results, 'results'):
            # Старая версия
            for var, result in results.results.items():
                p_value = float(result.p_value)
                test_stat = float(result.test_statistic)
                break
        elif isinstance(results, list) and len(results) > 0:
            # Новая версия - список
            result = results[0]
            if hasattr(result, 'p_value'):
                p_value = float(result.p_value)
                test_stat = float(result.test_statistic) if hasattr(result, 'test_statistic') else 0.0
        elif isinstance(results, dict):
            # Словарь
            for var, val in results.items():
                if isinstance(val, (int, float)):
                    p_value = float(val)
                elif hasattr(val, 'p_value'):
                    p_value = float(val.p_value)
                break
        
        return {
            "p_value": p_value,
            "test_statistic": test_stat,
            "violated": bool(p_value < 0.05)
        }
    except Exception as e:
        return {"p_value": 1.0, "test_statistic": 0.0, "violated": False, "error": str(e)}

def calculate_schoenfeld_all(cph, covariates_list):
    """Рассчитывает тест Шонфельда для всех ковариат по отдельности"""
    results = {}
    
    for cov in covariates_list:
        result = run_schoenfeld_test_single(cph, cov)
        results[str(cov)] = result
    
    return results

def calculate_vif(cov_list):
    """Расчет VIF для мультиколлинеарности"""
    if len(cov_list) < 2:
        return {}
    
    try:
        from statsmodels.stats.outliers_influence import variance_inflation_factor
        
        X = df_cox[cov_list].dropna()
        if X.shape[0] < 10 or X.shape[1] < 2:
            return {}
        
        vif_data = {}
        for i, col in enumerate(X.columns):
            try:
                vif = float(variance_inflation_factor(X.values, i))
                if np.isnan(vif) or np.isinf(vif):
                    vif = 999.0
                vif_data[str(col)] = {
                    "value": vif,
                    "high": bool(vif > 10),
                    "moderate": bool(vif > 5 and vif <= 10)
                }
            except Exception:
                vif_data[str(col)] = {
                    "value": 0.0,
                    "high": False,
                    "moderate": False
                }
        return vif_data
    except Exception as e:
        output_metrics["warnings"].append(f"VIF calculation error: {str(e)}")
        return {}

